<% layout("/layouts/boilerplate.ejs") %>

<div class="container-max my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">My Bookings</h2>
      <p class="text-muted mb-0">View all your confirmed reservations and travel history</p>
    </div>
    <a href="/listings" class="btn btn-primary rounded-pill">
      <i class="fa-solid fa-plus me-1"></i> Book a New Stay
    </a>
  </div>

  <% if (!bookings || bookings.length === 0) { %>
    <div class="text-center py-5 my-5 glass-card border rounded-4 p-5 reveal-on-scroll">
      <div class="brand-icon mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2rem; background: var(--primary-light); color: var(--primary);">
        <i class="fa-solid fa-suitcase-rolling"></i>
      </div>
      <h3 class="fw-bold mb-2">No trips yet.</h3>
      <p class="text-muted mb-4 max-w-500 mx-auto">When you book an extraordinary stay, your reservations, dates, and receipts will appear right here.</p>
      <a href="/listings" class="btn btn-primary rounded-pill px-5 py-2 fw-semibold">
        <i class="fa-solid fa-compass me-2"></i>Explore Stays
      </a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% bookings.forEach((booking) => { %>
        <% if (booking.listing) { %>
          <div class="col-12">
            <div class="ticket-card">
              <div class="ticket-media">
                <a href="/listings/<%= booking.listing._id %>">
                  <img 
                    src="<%= (booking.listing.image && booking.listing.image.url) ? booking.listing.image.url : (booking.listing.photos && booking.listing.photos[0] && (booking.listing.photos[0].url || booking.listing.photos[0])) || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80' %>" 
                    alt="<%= booking.listing.title %>"
                  />
                </a>
              </div>
              <div class="ticket-body">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-2 mb-2">
                  <div>
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                      <% if (booking.status === 'confirmed') { %>
                        <span class="badge badge-status badge-confirmed">
                          <i class="fa-solid fa-circle-check me-1"></i> Confirmed
                        </span>
                      <% } else if (booking.status === 'completed') { %>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                          <i class="fa-solid fa-flag-checkered me-1"></i> Completed
                        </span>
                      <% } else if (booking.status === 'pending') { %>
                        <span class="badge bg-warning-subtle text-warning border border-warning rounded-pill px-3 py-1">
                          <i class="fa-solid fa-hourglass-half me-1"></i> Pending Payment
                        </span>
                      <% } else if (booking.status === 'refund_pending') { %>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">
                          <i class="fa-solid fa-clock-rotate-left me-1"></i> Refund Pending
                        </span>
                      <% } else if (booking.status === 'refunded') { %>
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1">
                          <i class="fa-solid fa-rotate-left me-1"></i> Refunded
                        </span>
                      <% } else { %>
                        <span class="badge badge-status badge-cancelled">
                          <i class="fa-solid fa-circle-xmark me-1"></i> Cancelled
                        </span>
                      <% } %>

                      <!-- Payment Status Badge -->
                      <% if (booking.paymentStatus === 'paid') { %>
                        <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">
                          <i class="fa-solid fa-shield-check me-1"></i> Paid
                        </span>
                      <% } else if (booking.paymentStatus === 'refund_pending') { %>
                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2 py-1">
                          <i class="fa-solid fa-hourglass-half me-1"></i> Refund Pending
                        </span>
                      <% } else if (booking.paymentStatus === 'refunded') { %>
                        <span class="badge bg-info-subtle text-info rounded-pill px-2 py-1">
                          <i class="fa-solid fa-rotate-left me-1"></i> Refunded
                        </span>
                      <% } else if (booking.paymentStatus === 'failed') { %>
                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2 py-1">
                          <i class="fa-solid fa-triangle-exclamation me-1"></i> Payment Failed
                        </span>
                      <% } else { %>
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1">
                          <i class="fa-solid fa-credit-card me-1"></i> Unpaid
                        </span>
                      <% } %>
                    </div>

                    <h4 class="fw-bold mb-1">
                      <a href="/listings/<%= booking.listing._id %>" class="text-decoration-none text-reset">
                        <%= booking.listing.title %>
                      </a>
                    </h4>
                    <div class="small text-muted">
                      <i class="fa-solid fa-location-dot me-1 text-primary"></i>
                      <%= booking.listing.location %>, <%= booking.listing.country %>
                    </div>
                  </div>

                  <div class="text-md-end">
                    <div class="small text-muted">Total Price</div>
                    <div class="fs-5 fw-bold text-primary">&#8377; <%= Number(booking.totalPrice).toLocaleString("en-IN") %></div>
                  </div>
                </div>

                <div class="row g-2 p-3 bg-body-tertiary rounded-3 small mb-3 border border-theme">
                  <div class="col-sm-3">
                    <span class="text-muted">Dates:</span>
                    <strong class="d-block"><%= new Date(booking.checkIn).toLocaleDateString() %> — <%= new Date(booking.checkOut).toLocaleDateString() %></strong>
                  </div>
                  <div class="col-sm-3">
                    <span class="text-muted">Guests & Duration:</span>
                    <strong class="d-block"><%= booking.guests || 1 %> <%= (booking.guests === 1) ? 'guest' : 'guests' %> • <%= booking.nights %> <%= booking.nights === 1 ? 'night' : 'nights' %></strong>
                  </div>
                  <div class="col-sm-3">
                    <span class="text-muted">Reference:</span>
                    <strong class="d-block font-monospace">#<%= booking._id.toString().slice(-8).toUpperCase() %></strong>
                  </div>
                  <div class="col-sm-3">
                    <span class="text-muted">Payment:</span>
                    <strong class="d-block text-capitalize"><%= booking.paymentStatus || 'pending' %></strong>
                  </div>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-end">
                  <% if (booking.status === 'pending' || booking.paymentStatus === 'pending' || booking.paymentStatus === 'failed') { %>
                    <a href="/bookings/<%= booking._id %>/checkout" class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold">
                      <i class="fa-solid fa-credit-card me-1"></i> Complete Payment
                    </a>
                  <% } %>

                  <% if (booking.status === 'confirmed' || booking.paymentStatus === 'paid') { %>
                    <a href="/bookings/<%= booking._id %>/invoice" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold" title="Download Official Invoice PDF">
                      <i class="fa-solid fa-file-invoice-dollar me-1"></i> Download Invoice
                    </a>
                  <% } %>

                  <a href="/bookings/<%= booking._id %>" class="btn btn-light border btn-sm rounded-pill px-3 fw-semibold">
                    <i class="fa-solid fa-receipt me-1"></i> Details
                  </a>

                  <a href="/messages/new?listingId=<%= booking.listing._id %>&bookingId=<%= booking._id %>" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="fa-regular fa-message me-1"></i> Message Host
                  </a>
                  <a href="/listings/<%= booking.listing._id %>" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    View Stay
                  </a>

                  <% if (booking.status === 'confirmed' || booking.status === 'pending') { %>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 open-cancel-modal-btn" data-booking-id="<%= booking._id %>">
                      <i class="fa-solid fa-ban me-1"></i> Cancel
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Dynamic Cancellation Modal for History -->
<div class="modal fade" id="historyCancelModal" tabindex="-1" aria-labelledby="historyCancelModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-danger" id="historyCancelModalLabel">
          <i class="fa-solid fa-triangle-exclamation me-2"></i>Cancel Reservation?
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="historyCancelForm" method="POST" action="">
        <div class="modal-body pt-2">
          <p class="text-muted small mb-3">
            Review the cancellation policy and estimated refund before confirming:
          </p>

          <div id="cancelModalLoading" class="text-center py-3">
            <span class="spinner-border spinner-border-sm text-primary me-2"></span>
            <span class="small text-muted">Calculating policy rules &amp; refund eligibility...</span>
          </div>

          <div id="cancelModalContent" class="d-none">
            <div class="p-3 bg-body-tertiary rounded-3 border mb-3 small">
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Stay:</span>
                <span class="fw-semibold text-truncate ms-2" id="modalListingTitle" style="max-width: 250px;"></span>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Policy:</span>
                <span class="badge bg-light text-dark border" id="modalPolicyBadge"></span>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Total Paid:</span>
                <span class="fw-semibold" id="modalTotalPaid"></span>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Estimated Refund:</span>
                <span class="fw-bold text-success fs-6" id="modalRefundAmount"></span>
              </div>
              <div class="text-muted small mt-2 pt-2 border-top" id="modalExplanation" style="font-size: 0.75rem;"></div>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Reason for Cancellation (Optional)</label>
              <textarea name="reason" class="form-control rounded-3" rows="2" placeholder="Help the host understand why plans changed..."></textarea>
            </div>

            <div class="small text-muted">
              <i class="fa-solid fa-shield-check text-success me-1"></i>
              Refunds are issued directly to your original payment method. The reservation dates will be freed immediately.
            </div>
          </div>
        </div>
        <div class="modal-footer border-top-0 pt-0">
          <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Keep Booking</button>
          <button type="submit" class="btn btn-danger rounded-pill px-4" id="modalConfirmBtn" disabled>
            <i class="fa-solid fa-ban me-1"></i> Confirm Cancellation
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const cancelModalEl = document.getElementById('historyCancelModal');
    if (!cancelModalEl) return;
    const cancelModal = new bootstrap.Modal(cancelModalEl);
    const cancelForm = document.getElementById('historyCancelForm');
    const loadingEl = document.getElementById('cancelModalLoading');
    const contentEl = document.getElementById('cancelModalContent');
    const titleEl = document.getElementById('modalListingTitle');
    const policyEl = document.getElementById('modalPolicyBadge');
    const paidEl = document.getElementById('modalTotalPaid');
    const refundEl = document.getElementById('modalRefundAmount');
    const expEl = document.getElementById('modalExplanation');
    const confirmBtn = document.getElementById('modalConfirmBtn');

    document.querySelectorAll('.open-cancel-modal-btn').forEach(btn => {
      btn.addEventListener('click', async function() {
        const bookingId = this.dataset.bookingId;
        cancelForm.action = `/bookings/${bookingId}/cancel`;

        loadingEl.classList.remove('d-none');
        contentEl.classList.add('d-none');
        confirmBtn.disabled = true;

        cancelModal.show();

        try {
          const res = await fetch(`/bookings/${bookingId}/cancellation-preview`);
          const data = await res.json();

          if (res.ok && data.success) {
            titleEl.textContent = data.listingTitle;
            policyEl.textContent = `${data.policyName} Policy`;
            paidEl.textContent = `₹${Number(data.totalPaid).toLocaleString('en-IN')}`;
            refundEl.textContent = `₹${Number(data.refundAmount).toLocaleString('en-IN')} (${data.refundPercentage}%)`;
            expEl.textContent = data.explanation;

            loadingEl.classList.add('d-none');
            contentEl.classList.remove('d-none');
            confirmBtn.disabled = false;
          } else {
            loadingEl.innerHTML = `<span class="text-danger small">${data.message || 'Error loading refund details.'}</span>`;
            confirmBtn.disabled = false;
          }
        } catch (err) {
          loadingEl.innerHTML = `<span class="text-danger small">Network error loading refund preview. You can still confirm cancellation.</span>`;
          confirmBtn.disabled = false;
        }
      });
    });
  });
</script>
