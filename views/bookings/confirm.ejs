<% layout("/layouts/boilerplate.ejs") %>

<div class="row justify-content-center my-5">
  <div class="col-lg-8 col-md-10">
    <div class="glass-card rounded-4 p-4 p-md-5 text-center">
      <div class="brand-icon mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.8rem; background: #DCFCE7; color: #166534;">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      
      <h2 class="fw-bold mb-1">Reservation Confirmed!</h2>
      <p class="text-muted mb-4">We've sent the booking confirmation details to your account.</p>

      <% if (booking && booking.listing) { %>
        <div class="ticket-card text-start mb-4">
          <div class="ticket-media">
            <img 
              src="<%= (booking.listing.image && booking.listing.image.url) ? booking.listing.image.url : (booking.listing.photos && booking.listing.photos[0] && (booking.listing.photos[0].url || booking.listing.photos[0])) || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80' %>" 
              alt="<%= booking.listing.title %>"
            />
          </div>
          <div class="ticket-body">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge badge-status badge-confirmed"><i class="fa-solid fa-check me-1"></i><%= booking.status %></span>
                <span class="small text-muted">Booking #<%= booking._id.toString().slice(-6).toUpperCase() %></span>
              </div>
              <h4 class="fw-bold mb-1"><%= booking.listing.title %></h4>
              <div class="small text-muted mb-3"><i class="fa-solid fa-location-dot me-1 text-primary"></i><%= booking.listing.location %>, <%= booking.listing.country %></div>
            </div>

            <div class="row g-2 p-3 bg-body-tertiary rounded-3 small border border-theme">
              <div class="col-6">
                <div class="text-muted">Check-in</div>
                <div class="fw-bold"><%= new Date(booking.checkIn).toDateString() %></div>
              </div>
              <div class="col-6">
                <div class="text-muted">Check-out</div>
                <div class="fw-bold"><%= new Date(booking.checkOut).toDateString() %></div>
              </div>
              <div class="col-6 mt-2">
                <div class="text-muted">Duration</div>
                <div class="fw-bold"><%= booking.nights %> <%= booking.nights === 1 ? 'Night' : 'Nights' %></div>
              </div>
              <div class="col-6 mt-2">
                <div class="text-muted">Total Paid</div>
                <div class="fw-bold text-primary fs-6">&#8377; <%= Number(booking.totalPrice).toLocaleString("en-IN") %></div>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <div class="d-flex justify-content-center gap-3">
        <a href="/bookings/history" class="btn btn-primary rounded-pill px-4">
          <i class="fa-solid fa-suitcase me-1"></i> View All Bookings
        </a>
        <a href="/listings" class="btn btn-outline-secondary rounded-pill px-4">
          Explore More Stays
        </a>
      </div>
    </div>
  </div>
</div>
