<% layout('/layouts/boilerplate.ejs') %>

<% 
  const isPaid = (booking.paymentStatus === 'paid' || booking.status === 'confirmed');
  const isCancelled = (booking.status === 'cancelled' || booking.status === 'refunded' || booking.status === 'refund_pending');
  const host = booking.listing ? booking.listing.owner : null;
  const guest = booking.guest;
  const pricePerNight = booking.listing ? booking.listing.price : Math.round((booking.totalPrice - 1250) / (booking.nights || 1));
  const subtotal = pricePerNight * (booking.nights || 1);
  const cleaningFee = 500;
  const serviceFee = 750;
%>

<div class="container-max my-4">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Home</a></li>
      <li class="breadcrumb-item"><a href="/bookings/history" class="text-decoration-none text-muted">My Bookings</a></li>
      <li class="breadcrumb-item active text-body fw-semibold" aria-current="page">Booking #<%= booking._id.toString().slice(-8).toUpperCase() %></li>
    </ol>
  </nav>

  <!-- Header Banner -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 p-4 glass-card rounded-4 border">
    <div>
      <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
        <span class="badge font-monospace bg-body-tertiary text-body border px-2.5 py-1">
          #<%= booking._id.toString().slice(-8).toUpperCase() %>
        </span>

        <% if (booking.status === 'confirmed') { %>
          <span class="badge badge-status badge-confirmed">
            <i class="fa-solid fa-circle-check me-1"></i> Confirmed
          </span>
        <% } else if (booking.status === 'completed') { %>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
            <i class="fa-solid fa-flag-checkered me-1"></i> Completed
          </span>
        <% } else if (booking.status === 'cancelled') { %>
          <span class="badge badge-status badge-cancelled">
            <i class="fa-solid fa-ban me-1"></i> Cancelled
          </span>
        <% } else if (booking.status === 'refund_pending') { %>
          <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">
            <i class="fa-solid fa-clock-rotate-left me-1"></i> Refund Pending
          </span>
        <% } else if (booking.status === 'refunded') { %>
          <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1">
            <i class="fa-solid fa-rotate-left me-1"></i> Refunded
          </span>
        <% } else { %>
          <span class="badge bg-warning-subtle text-warning border border-warning rounded-pill px-3 py-1">
            <i class="fa-solid fa-clock me-1"></i> <%= booking.status %>
          </span>
        <% } %>

        <% if (booking.paymentStatus === 'paid') { %>
          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
            <i class="fa-solid fa-shield-check me-1"></i> Paid
          </span>
        <% } else if (booking.paymentStatus === 'refund_pending') { %>
          <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1">
            <i class="fa-solid fa-hourglass-half me-1"></i> Refund Pending
          </span>
        <% } else if (booking.paymentStatus === 'refunded') { %>
          <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2.5 py-1">
            <i class="fa-solid fa-rotate-left me-1"></i> Refunded
          </span>
        <% } else if (booking.paymentStatus === 'failed') { %>
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
            <i class="fa-solid fa-triangle-exclamation me-1"></i> Payment Failed
          </span>
        <% } else { %>
          <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1">
            <i class="fa-solid fa-credit-card me-1"></i> Unpaid
          </span>
        <% } %>
      </div>

      <h2 class="fw-bold mb-1" style="letter-spacing: -0.02em;">
        <%= booking.listing ? booking.listing.title : 'Reservation Details' %>
      </h2>
      <div class="text-muted small">
        <i class="fa-solid fa-location-dot me-1 text-primary"></i>
        <%= booking.listing ? `${booking.listing.location}, ${booking.listing.country}` : 'Destination Worldwide' %>
        • Booked on <%= new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex flex-wrap gap-2 align-items-center">
      <!-- Invoice Download Button -->
      <a href="/bookings/<%= booking._id %>/invoice" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" title="Download Official PDF Invoice">
        <i class="fa-solid fa-file-invoice-dollar me-2"></i> Download Invoice
      </a>

      <% if (booking.listing) { %>
        <a href="/messages/new?listingId=<%= booking.listing._id %>&bookingId=<%= booking._id %>" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold">
          <i class="fa-regular fa-message me-1"></i> Message Host
        </a>
        <a href="/listings/<%= booking.listing._id %>" class="btn btn-light border rounded-pill px-3 py-2 fw-semibold">
          <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> View Stay
        </a>
      <% } %>
    </div>
  </div>

  <div class="row g-4">
    <!-- Left Column: Details & Itinerary -->
    <div class="col-lg-7">
      
      <!-- Stay Showcase Card -->
      <% if (booking.listing) { %>
        <div class="glass-card rounded-4 p-4 mb-4 border">
          <div class="row g-3 align-items-center">
            <div class="col-sm-4">
              <img 
                src="<%= (booking.listing.image && booking.listing.image.url) ? booking.listing.image.url : 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80' %>" 
                alt="<%= booking.listing.title %>"
                class="rounded-3 w-100 border shadow-sm"
                style="height: 140px; object-fit: cover;"
              />
            </div>
            <div class="col-sm-8">
              <span class="badge bg-secondary-subtle text-secondary rounded-pill mb-1">
                <%= booking.listing.category %>
              </span>
              <h4 class="fw-bold mb-1"><%= booking.listing.title %></h4>
              <p class="text-muted small mb-2 line-clamp-2">
                <%= booking.listing.description ? booking.listing.description.slice(0, 140) + '...' : '' %>
              </p>
              <div class="d-flex align-items-center gap-3 small text-muted">
                <span><i class="fa-solid fa-star text-warning me-1"></i><%= booking.listing.averageRating > 0 ? booking.listing.averageRating : '5.0' %> rating</span>
                <span>•</span>
                <span>₹<%= booking.listing.price.toLocaleString('en-IN') %> / night</span>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Schedule & Itinerary Card -->
      <div class="glass-card rounded-4 p-4 mb-4 border">
        <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
          <i class="fa-solid fa-calendar-days text-primary"></i> Reservation Itinerary
        </h5>

        <div class="row g-3 p-3 bg-body-tertiary rounded-3 border mb-3">
          <div class="col-6 col-sm-3 border-end">
            <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Check-in</div>
            <div class="fw-bold fs-6"><%= new Date(booking.checkIn).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
            <div class="text-muted small">From 3:00 PM</div>
          </div>
          <div class="col-6 col-sm-3 border-end">
            <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Check-out</div>
            <div class="fw-bold fs-6"><%= new Date(booking.checkOut).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
            <div class="text-muted small">By 11:00 AM</div>
          </div>
          <div class="col-6 col-sm-3 border-end">
            <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Duration</div>
            <div class="fw-bold fs-6"><%= booking.nights %> <%= booking.nights === 1 ? 'Night' : 'Nights' %></div>
            <div class="text-muted small">Total stay</div>
          </div>
          <div class="col-6 col-sm-3">
            <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Travelers</div>
            <div class="fw-bold fs-6"><%= booking.guests || 1 %> <%= (booking.guests === 1) ? 'Guest' : 'Guests' %></div>
            <div class="text-muted small">Registered</div>
          </div>
        </div>

        <div class="p-3 rounded-3 border bg-light small">
          <div class="d-flex align-items-center gap-2 mb-1 fw-bold text-body">
            <i class="fa-solid fa-key text-primary"></i> Self Check-in Guide
          </div>
          <p class="text-muted mb-0">
            Check-in details and keycode instructions will be coordinated with your host via the WanderStay messaging channel prior to arrival.
          </p>
        </div>
      </div>

      <!-- Host & Support Card -->
      <div class="glass-card rounded-4 p-4 border">
        <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
          <i class="fa-solid fa-house-chimney-user text-primary"></i> Host Information
        </h5>

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
          <div class="d-flex align-items-center gap-3">
            <img 
              src="<%= (host && host.avatar) ? host.avatar : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=120&q=80' %>" 
              alt="Host avatar" 
              class="rounded-circle border"
              style="width: 52px; height: 52px; object-fit: cover;"
            />
            <div>
              <div class="fw-bold text-body fs-6"><%= host ? host.fullName || host.username : 'WanderStay Verified Host' %></div>
              <div class="text-muted small">@<%= host ? host.username : 'host' %> • Verified Property Partner</div>
              <div class="text-muted small" style="font-size: 0.75rem;"><%= host ? host.email : '' %></div>
            </div>
          </div>

          <% if (booking.listing) { %>
            <a href="/messages/new?listingId=<%= booking.listing._id %>&bookingId=<%= booking._id %>" class="btn btn-outline-primary rounded-pill px-4 btn-sm fw-semibold">
              <i class="fa-regular fa-message me-1"></i> Chat with Host
            </a>
          <% } %>
        </div>
      </div>

    </div>

    <!-- Right Column: Financial Breakdown & Invoice Card -->
    <div class="col-lg-5">
      
      <!-- Price & Invoice Card -->
      <div class="glass-card rounded-4 p-4 mb-4 border">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold mb-0">Financial Summary</h5>
          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
            <i class="fa-solid fa-check me-1"></i> Paid in Full
          </span>
        </div>

        <div class="d-flex flex-column gap-2.5 py-2 border-bottom mb-3 small">
          <% const pb = booking.priceBreakdown; %>
          <% if (pb && pb.isDynamicPricingActive) { %>
            <% if (pb.weekdayNights > 0) { %>
              <div class="d-flex justify-content-between">
                <span class="text-muted">₹<%= pb.weekdayRate.toLocaleString('en-IN') %> × <%= pb.weekdayNights %> weekday <%= pb.weekdayNights === 1 ? 'night' : 'nights' %></span>
                <span class="fw-semibold">₹<%= pb.weekdayTotal.toLocaleString('en-IN') %></span>
              </div>
            <% } %>
            <% if (pb.weekendNights > 0) { %>
              <div class="d-flex justify-content-between text-warning-emphasis">
                <span><i class="fa-solid fa-champagne-glasses me-1"></i>₹<%= pb.weekendRate.toLocaleString('en-IN') %> × <%= pb.weekendNights %> weekend <%= pb.weekendNights === 1 ? 'night' : 'nights' %></span>
                <span class="fw-semibold">₹<%= pb.weekendTotal.toLocaleString('en-IN') %></span>
              </div>
            <% } %>
            <% if (pb.seasonalNights > 0) { %>
              <div class="d-flex justify-content-between text-primary">
                <span><i class="fa-solid fa-cloud-sun me-1"></i><%= pb.seasonalName || 'Seasonal' %>: ₹<%= pb.seasonalRate.toLocaleString('en-IN') %> × <%= pb.seasonalNights %> <%= pb.seasonalNights === 1 ? 'night' : 'nights' %></span>
                <span class="fw-semibold">₹<%= pb.seasonalTotal.toLocaleString('en-IN') %></span>
              </div>
            <% } %>
            <% if (pb.holidayNights > 0) { %>
              <div class="d-flex justify-content-between text-danger">
                <span><i class="fa-solid fa-holly-berry me-1"></i><%= pb.holidayName || 'Holiday' %>: ₹<%= pb.holidayRate.toLocaleString('en-IN') %> × <%= pb.holidayNights %> <%= pb.holidayNights === 1 ? 'night' : 'nights' %></span>
                <span class="fw-semibold">₹<%= pb.holidayTotal.toLocaleString('en-IN') %></span>
              </div>
            <% } %>
            <% if (pb.extraGuestTotal > 0) { %>
              <div class="d-flex justify-content-between text-success">
                <span><i class="fa-solid fa-user-plus me-1"></i><%= pb.extraGuests %> extra <%= pb.extraGuests === 1 ? 'guest' : 'guests' %> × <%= booking.nights %> nts (@₹<%= pb.extraGuestFeePerNight %>/nt)</span>
                <span class="fw-semibold">₹<%= pb.extraGuestTotal.toLocaleString('en-IN') %></span>
              </div>
            <% } %>
          <% } else { %>
            <div class="d-flex justify-content-between">
              <span class="text-muted">₹<%= pricePerNight.toLocaleString('en-IN') %> × <%= booking.nights %> nights</span>
              <span class="fw-semibold">₹<%= subtotal.toLocaleString('en-IN') %></span>
            </div>
          <% } %>
          <div class="d-flex justify-content-between">
            <span class="text-muted">Standard Cleaning Fee</span>
            <span class="fw-semibold">₹<%= cleaningFee.toLocaleString('en-IN') %></span>
          </div>
          <div class="d-flex justify-content-between">
            <span class="text-muted">WanderStay Service &amp; Platform Fee</span>
            <span class="fw-semibold">₹<%= serviceFee.toLocaleString('en-IN') %></span>
          </div>
          <div class="d-flex justify-content-between">
            <span class="text-muted">Promotional Discount <%= (booking.coupon && booking.coupon.code) ? `(${booking.coupon.code})` : '' %></span>
            <span class="fw-semibold text-success"><%= booking.discountAmount > 0 ? `-₹${Number(booking.discountAmount).toLocaleString('en-IN')}` : '₹0.00' %></span>
          </div>
        </div>

        <!-- Total Paid -->
        <div class="d-flex justify-content-between align-items-center py-2 mb-3">
          <span class="fw-bold fs-6">Total Amount Paid</span>
          <span class="fw-bold fs-4 text-primary">₹<%= Number(booking.totalPrice).toLocaleString('en-IN') %></span>
        </div>

        <!-- Safe Payment Metadata -->
        <div class="p-3 rounded-3 bg-body-tertiary border mb-3 small">
          <div class="text-muted fw-semibold text-uppercase mb-2" style="font-size: 0.7rem;">Payment Verification</div>
          
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Gateway:</span>
            <span class="fw-semibold">Razorpay Verified</span>
          </div>

          <% if (booking.razorpayPaymentId) { %>
            <div class="d-flex justify-content-between mb-1">
              <span class="text-muted">Payment ID:</span>
              <code class="text-body"><%= booking.razorpayPaymentId %></code>
            </div>
          <% } %>

          <% if (booking.razorpayOrderId) { %>
            <div class="d-flex justify-content-between mb-1">
              <span class="text-muted">Order ID:</span>
              <code class="text-muted"><%= booking.razorpayOrderId %></code>
            </div>
          <% } %>

          <% if (booking.paidAt) { %>
            <div class="d-flex justify-content-between">
              <span class="text-muted">Timestamp:</span>
              <span><%= new Date(booking.paidAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
            </div>
          <% } %>
        </div>

        <!-- Download Invoice Prominent CTA -->
        <a href="/bookings/<%= booking._id %>/invoice" class="btn btn-primary w-100 rounded-pill py-2.5 fw-bold shadow-sm mb-2">
          <i class="fa-solid fa-file-pdf me-2"></i> Download Official PDF Invoice
        </a>
        <div class="text-center text-muted small" style="font-size: 0.72rem;">
          <i class="fa-solid fa-lock text-success me-1"></i> Official receipt verified by WanderStay Inc.
        </div>
      </div>

      <!-- Cancellation & Actions Card -->
      <div class="glass-card rounded-4 p-4 border">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h6 class="fw-bold mb-0">Cancellation Policy</h6>
          <span class="badge <%= (cancellationPolicy && cancellationPolicy.badgeClass) || 'bg-success-subtle text-success' %> rounded-pill px-2.5 py-1">
            <%= (cancellationPolicy && cancellationPolicy.name) || 'Flexible' %>
          </span>
        </div>
        
        <p class="text-muted small mb-3">
          <%= (cancellationPolicy && cancellationPolicy.summary) || 'Free cancellation available.' %>
        </p>

        <% if (!isCancelled && booking.status !== 'completed') { %>
          <div class="p-3 rounded-3 bg-body-tertiary border mb-3 small">
            <div class="text-muted mb-1">Estimated Refund If Cancelled Now:</div>
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-bold fs-6 <%= refundPreview && refundPreview.refundAmount > 0 ? 'text-success' : 'text-muted' %>">
                ₹<%= refundPreview ? Number(refundPreview.refundAmount).toLocaleString('en-IN') : 0 %>
                <span class="small fw-normal text-muted">(<%= refundPreview ? refundPreview.refundPercentage : 0 %>%)</span>
              </span>
              <span class="small text-muted"><%= refundPreview ? refundPreview.hoursUntilCheckIn : 0 %> hrs to check-in</span>
            </div>
            <% if (refundPreview && refundPreview.explanation) { %>
              <div class="small text-muted mt-1.5" style="font-size: 0.75rem; line-height: 1.35;">
                <i class="fa-solid fa-circle-info me-1 text-primary"></i><%= refundPreview.explanation %>
              </div>
            <% } %>
          </div>

          <button type="button" class="btn btn-outline-danger w-100 rounded-pill btn-sm py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#cancelModal">
            <i class="fa-solid fa-ban me-1"></i> Cancel Reservation
          </button>
        <% } else if (isCancelled) { %>
          <div class="alert alert-danger mb-0 small rounded-3 p-3">
            <div class="fw-bold mb-1"><i class="fa-solid fa-circle-xmark me-1"></i> Reservation Cancelled</div>
            <% if (booking.cancellation && booking.cancellation.cancelledAt) { %>
              <div class="text-muted small mb-1">
                Cancelled on <%= new Date(booking.cancellation.cancelledAt).toLocaleDateString() %>
                <% if (booking.cancellation.reason) { %> &bull; Reason: "<%= booking.cancellation.reason %>"<% } %>
              </div>
            <% } %>
            <% if (booking.cancellation && booking.cancellation.refundAmount > 0) { %>
              <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-danger-subtle">
                <span>Refund Processed:</span>
                <span class="fw-bold text-success fs-6">₹<%= Number(booking.cancellation.refundAmount).toLocaleString('en-IN') %> (<%= booking.cancellation.refundPercentage %>%)</span>
              </div>
              <% if (booking.cancellation.refundId) { %>
                <div class="small font-monospace text-muted mt-1" style="font-size: 0.72rem;">Refund Ref: <%= booking.cancellation.refundId %></div>
              <% } %>
            <% } else if (booking.paymentStatus === 'refund_pending') { %>
              <div class="small text-warning fw-semibold mt-1">
                <i class="fa-solid fa-hourglass-half me-1"></i> Refund pending gateway settlement.
              </div>
            <% } else { %>
              <div class="small text-muted mt-1">No refund was eligible based on cancellation timing.</div>
            <% } %>
          </div>
        <% } else { %>
          <div class="alert alert-secondary mb-0 small rounded-3 p-2 text-center">
            <i class="fa-solid fa-flag-checkered me-1"></i> This stay has been completed.
          </div>
        <% } %>
      </div>

    </div>
  </div>
</div>

<!-- Cancellation Confirmation Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-danger" id="cancelModalLabel">
          <i class="fa-solid fa-triangle-exclamation me-2"></i>Cancel Reservation?
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/bookings/<%= booking._id %>/cancel" method="POST">
        <div class="modal-body pt-2">
          <p class="text-muted small mb-3">
            Are you sure you want to cancel your stay at <strong><%= booking.listing ? booking.listing.title : 'this property' %></strong>?
          </p>

          <div class="p-3 bg-body-tertiary rounded-3 border mb-3 small">
            <div class="d-flex justify-content-between mb-1">
              <span class="text-muted">Policy Applied:</span>
              <span class="fw-semibold"><%= (cancellationPolicy && cancellationPolicy.name) || 'Flexible' %></span>
            </div>
            <div class="d-flex justify-content-between mb-1">
              <span class="text-muted">Total Paid:</span>
              <span class="fw-semibold">₹<%= Number(booking.totalPrice).toLocaleString('en-IN') %></span>
            </div>
            <div class="d-flex justify-content-between mb-1">
              <span class="text-muted">Calculated Refund:</span>
              <span class="fw-bold text-success fs-6">₹<%= refundPreview ? Number(refundPreview.refundAmount).toLocaleString('en-IN') : 0 %> (<%= refundPreview ? refundPreview.refundPercentage : 0 %>%)</span>
            </div>
            <% if (refundPreview && refundPreview.nonRefundableAmount > 0) { %>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Non-refundable Portion:</span>
                <span class="text-danger fw-semibold">₹<%= Number(refundPreview.nonRefundableAmount).toLocaleString('en-IN') %></span>
              </div>
            <% } %>
            <% if (refundPreview && refundPreview.explanation) { %>
              <div class="text-muted small mt-2 pt-2 border-top" style="font-size: 0.75rem;">
                <i class="fa-solid fa-circle-info me-1 text-primary"></i><%= refundPreview.explanation %>
              </div>
            <% } %>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Reason for Cancellation (Optional)</label>
            <textarea name="reason" class="form-control rounded-3" rows="2" placeholder="Help the host understand why plans changed..."></textarea>
          </div>

          <div class="small text-muted">
            <i class="fa-solid fa-shield-check text-success me-1"></i>
            Eligible refunds are processed directly back to your original payment method. The reservation dates will be freed for other travelers.
          </div>
        </div>
        <div class="modal-footer border-top-0 pt-0">
          <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Keep Booking</button>
          <button type="submit" class="btn btn-danger rounded-pill px-4">
            <i class="fa-solid fa-ban me-1"></i> Confirm Cancellation
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
