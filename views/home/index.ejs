<!-- ==========================================================================
     8. BECOME A HOST SECTION
     ========================================================================== -->
<div class="container-max my-5">
  <section class="host-spotlight-card p-4 p-md-5 reveal-on-scroll">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1 fw-bold mb-3">
          <i class="fa-solid fa-house-chimney me-1"></i> HOST COMMUNITY
        </span>
