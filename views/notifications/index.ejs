<% layout('layouts/boilerplate') -%>

<div class="container-max py-4 py-lg-5">
  <!-- Page Header -->
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
          <i class="fa-solid fa-bell me-1"></i>Activity Center
        </span>
        <% if (unreadCount > 0) { %>
          <span class="badge bg-danger rounded-pill px-2 py-1">
            <%= unreadCount %> unread
          </span>
        <% } %>
      </div>
      <h1 class="h3 fw-bold mb-1">Notifications</h1>
      <p class="text-muted small mb-0">Stay informed about your reservations, payments, messages, and property updates.</p>
    </div>

    <!-- Actions -->
    <div class="d-flex align-items-center gap-2">
      <% if (unreadCount > 0) { %>
        <form action="/notifications/read-all" method="POST" class="m-0">
          <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-check-double text-success"></i>
            <span>Mark all as read</span>
          </button>
        </form>
      <% } %>
      <a href="/listings" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-2">
        <i class="fa-solid fa-compass"></i>
        <span>Explore Stays</span>
      </a>
    </div>
  </div>

  <!-- Filter Navigation Tabs -->
  <div class="d-flex align-items-center gap-2 mb-4 p-1 bg-body-tertiary rounded-pill d-inline-flex border">
    <a href="/notifications" class="notif-filter-tab <%= activeFilter === 'all' ? 'active' : '' %>">
      <i class="fa-solid fa-inbox"></i>
      <span>All</span>
      <span class="badge <%= activeFilter === 'all' ? 'bg-white text-dark' : 'bg-secondary-subtle text-secondary' %> rounded-pill ms-1">
        <%= notifications ? notifications.length : 0 %>
      </span>
    </a>
    <a href="/notifications?filter=unread" class="notif-filter-tab <%= activeFilter === 'unread' ? 'active' : '' %>">
      <i class="fa-solid fa-envelope"></i>
      <span>Unread</span>
      <% if (unreadCount > 0) { %>
        <span class="badge <%= activeFilter === 'unread' ? 'bg-white text-danger' : 'bg-danger text-white' %> rounded-pill ms-1">
          <%= unreadCount %>
        </span>
      <% } %>
    </a>
  </div>

  <!-- Notifications List Card -->
  <div class="notif-page-card">
    <% if (notifications && notifications.length > 0) { %>
      <div class="divide-y">
        <% notifications.forEach(notif => { 
             const meta = (typeof getNotificationMeta === 'function') ? getNotificationMeta(notif.type) : { icon: 'fa-solid fa-bell', color: '#6B7280', bg: '#F3F4F6', label: 'Notification' };
        %>
          <div class="notif-row <%= !notif.isRead ? 'unread' : '' %>">
            <div class="d-flex align-items-start gap-3 flex-grow-1 min-w-0">
              <!-- Type Icon -->
              <div class="notif-row-icon shadow-xs" style="background-color: <%= meta.bg %>; color: <%= meta.color %>;">
                <i class="<%= meta.icon %>"></i>
              </div>

              <!-- Content -->
              <div class="flex-grow-1 min-w-0">
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                  <span class="notif-row-title text-truncate"><%= notif.title %></span>
                  <span class="badge border rounded-pill" style="font-size: 0.68rem; background: <%= meta.bg %>; color: <%= meta.color %>; border-color: <%= meta.color %>20 !important;">
                    <%= meta.label %>
                  </span>
                  <% if (!notif.isRead) { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill" style="font-size: 0.65rem;">
                      New
                    </span>
                  <% } %>
                </div>

                <div class="notif-row-msg">
                  <%= notif.message %>
                </div>

                <div class="notif-row-meta">
                  <span>
                    <i class="fa-regular fa-clock me-1"></i>
                    <%= new Date(notif.createdAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                  </span>
                  <span>•</span>
                  <span><%= notif.isRead ? 'Read' : 'Unread' %></span>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex align-items-center gap-2 ms-auto">
              <!-- Open / View button: navigates to link and marks read -->
              <a 
                href="/notifications/<%= notif._id %>/open" 
                class="btn btn-outline-primary notif-action-btn"
                title="View details"
              >
                <span>View</span>
                <i class="fa-solid fa-arrow-right fs-xs"></i>
              </a>

              <!-- Delete Notification Form -->
              <form action="/notifications/<%= notif._id %>/delete" method="POST" class="m-0">
                <button type="submit" class="notif-delete-btn" title="Delete notification" aria-label="Delete">
                  <i class="fa-regular fa-trash-can"></i>
                </button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <!-- Empty State -->
      <div class="py-5 text-center px-4">
        <div class="notif-empty-icon mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2rem;">
          <i class="fa-regular fa-bell-slash"></i>
        </div>
        <h4 class="fw-bold mb-2">No notifications found</h4>
        <p class="text-muted small mx-auto mb-4" style="max-width: 420px;">
          <% if (activeFilter === 'unread') { %>
            You have read all your notifications! Switch to "All" to view previous activity.
          <% } else { %>
            You're all caught up! Once you make reservations, receive messages, or get reviews, updates will appear here.
          <% } %>
        </p>
        <div class="d-flex justify-content-center gap-2">
          <% if (activeFilter === 'unread') { %>
            <a href="/notifications" class="btn btn-outline-secondary rounded-pill px-4 btn-sm">
              <i class="fa-solid fa-inbox me-1"></i>View All Notifications
            </a>
          <% } else { %>
            <a href="/listings" class="btn btn-primary rounded-pill px-4 btn-sm shadow-sm">
              <i class="fa-solid fa-compass me-1"></i>Explore Stays
            </a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>
