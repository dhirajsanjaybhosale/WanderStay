<footer class="site-footer">
  <div class="container-max">
    <div class="row g-4 pb-4">
      <!-- Brand & Tagline -->
      <div class="col-lg-4 col-md-6">
        <div class="footer-brand mb-3">
          <a href="/" class="text-decoration-none text-reset">
            <%- include('../components/logo.ejs', { variant: 'footer', size: 'md' }) %>
          </a>
        </div>
        <p class="text-secondary small mb-4 leading-relaxed" style="max-width: 340px;">
          <%= t('footer.tagline') %>
        </p>
        <div class="footer-social-links d-flex gap-3">
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-circle-link" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
          <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="social-circle-link" aria-label="X / Twitter"><i class="fa-brands fa-x-twitter"></i></a>
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="social-circle-link" aria-label="Facebook"><i class="fa-brands fa-facebook"></i></a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-circle-link" aria-label="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
        </div>
      </div>

      <!-- Quick Links: Explore -->
      <div class="col-lg-2 col-md-3 col-6">
        <h6 class="fw-bold text-white mb-3 text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.08em;"><%= t('footer.explore') %></h6>
        <ul class="list-unstyled d-flex flex-column gap-2 small">
          <li><a href="/listings" class="footer-link"><%= t('footer.allStays') %></a></li>
          <li><a href="/listings?category=Beach" class="footer-link"><%= t('footer.beachfrontVillas') %></a></li>
          <li><a href="/listings?category=Mountain" class="footer-link"><%= t('footer.mountainCabins') %></a></li>
          <li><a href="/listings?category=Villa" class="footer-link"><%= t('footer.luxuryEstates') %></a></li>
          <li><a href="/ai-planner" class="footer-link"><%= t('footer.aiPlanner') %></a></li>
        </ul>
      </div>

      <!-- Host & Group Travel -->
      <div class="col-lg-2 col-md-3 col-6">
        <h6 class="fw-bold text-white mb-3 text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.08em;"><%= t('footer.hostingTrips') %></h6>
        <ul class="list-unstyled d-flex flex-column gap-2 small">
          <li><a href="/become-host" class="footer-link"><%= t('footer.becomeHost') %></a></li>
          <li><a href="/listings/new" class="footer-link"><%= t('footer.listHome') %></a></li>
          <li><a href="/dashboard/host" class="footer-link"><%= t('footer.hostDashboard') %></a></li>
          <li><a href="/trips" class="footer-link"><%= t('footer.groupTrips') %></a></li>
          <li><a href="/dashboard" class="footer-link"><%= t('footer.guestPortal') %></a></li>
        </ul>
      </div>

      <!-- Company & Support -->
      <div class="col-lg-4 col-md-6">
        <h6 class="fw-bold text-white mb-3 text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.08em;"><%= t('footer.travelIntelligence') %></h6>
        <p class="text-secondary small mb-3">
          <%= t('footer.newsletterDesc') %>
        </p>
        <div class="footer-newsletter-wrap">
          <form class="d-flex gap-2" onsubmit="event.preventDefault(); alert('Thank you for subscribing to WanderStay Curated Escapes!'); this.reset();">
            <input 
              type="email" 
              class="form-control form-control-sm rounded-pill px-3" 
              placeholder="<%= t('footer.emailPlaceholder') %>" 
              required 
              aria-label="<%= t('footer.emailPlaceholder') %>" 
            />
            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold"><%= t('footer.subscribe') %></button>
          </form>
        </div>
        <div class="small text-secondary mt-2" style="font-size: 0.72rem;">
          <i class="fa-solid fa-shield-halved text-success me-1"></i> <%= t('footer.noSpam') %>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright, Legal & Language Selector -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-4 border-top border-secondary border-opacity-25 small text-secondary gap-3">
      <div class="d-flex align-items-center gap-2">
        <span>&copy; <%= new Date().getFullYear() %> WanderStay, Inc. <%= t('footer.allRightsReserved') %></span>
      </div>

      <!-- Footer Language & Currency Selectors -->
      <div class="d-flex flex-wrap align-items-center gap-2 justify-content-center">
        <!-- Footer Language Selector Pills -->
        <div class="d-flex align-items-center gap-1.5 p-1 bg-dark bg-opacity-50 rounded-pill border border-secondary border-opacity-25">
          <span class="text-muted px-2 py-0.5" style="font-size: 0.72rem;">
            <i class="fa-solid fa-globe text-primary me-1"></i><%= t('common.language') %>:
          </span>
          <form action="/set-language" method="POST" class="d-inline m-0">
            <input type="hidden" name="lang" value="en">
            <button type="submit" class="btn btn-sm py-0.5 px-2 rounded-pill <%= (typeof currentLang === 'undefined' || currentLang === 'en') ? 'btn-primary fw-bold' : 'btn-link text-secondary text-decoration-none' %>" style="font-size: 0.75rem;">
              EN
            </button>
          </form>
          <form action="/set-language" method="POST" class="d-inline m-0">
            <input type="hidden" name="lang" value="hi">
            <button type="submit" class="btn btn-sm py-0.5 px-2 rounded-pill <%= (typeof currentLang !== 'undefined' && currentLang === 'hi') ? 'btn-primary fw-bold' : 'btn-link text-secondary text-decoration-none' %>" style="font-size: 0.75rem;">
              हिंदी
            </button>
          </form>
          <form action="/set-language" method="POST" class="d-inline m-0">
            <input type="hidden" name="lang" value="mr">
            <button type="submit" class="btn btn-sm py-0.5 px-2 rounded-pill <%= (typeof currentLang !== 'undefined' && currentLang === 'mr') ? 'btn-primary fw-bold' : 'btn-link text-secondary text-decoration-none' %>" style="font-size: 0.75rem;">
              मराठी
            </button>
          </form>
        </div>
      </div>

      <div class="d-flex gap-3 footer-legal-links">
        <a href="/listings" class="footer-link"><%= t('footer.privacy') %></a>
        <span>•</span>
        <a href="/listings" class="footer-link"><%= t('footer.terms') %></a>
        <span>•</span>
        <a href="/listings" class="footer-link"><%= t('footer.sitemap') %></a>
        <span>•</span>
        <a href="/listings" class="footer-link"><%= t('footer.trustSafety') %></a>
      </div>
    </div>
  </div>
</footer>
