<% const user = (typeof currUser !== 'undefined' && currUser) ? currUser : ((typeof CurrUser !== 'undefined' && CurrUser) ? CurrUser : null); %>

<nav class="site-navbar navbar navbar-expand-lg sticky-top" id="mainSiteNavbar" role="navigation" aria-label="Main navigation">
  <div class="container-max d-flex align-items-center justify-content-between">
    <!-- Brand Logo -->
    <a class="navbar-brand-wrapper text-decoration-none" href="/" aria-label="WanderStay Homepage">
      <%- include('../components/logo.ejs', { variant: 'full', size: 'md' }) %>
    </a>

    <!-- Center Search Bar (Desktop) -->
    <form class="nav-search-bar d-none d-lg-flex" action="/listings" method="GET" role="search">
      <div class="nav-search-inner">
        <i class="fa-solid fa-magnifying-glass nav-search-icon"></i>
        <input 
          type="search" 
          name="q" 
          placeholder="Where to? (e.g. Bali, Paris, Manali)" 
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          aria-label="Search stays by destination, title, or category"
          autocomplete="off"
        />
        <button class="nav-search-btn" type="submit" aria-label="Search">
          <span>Search</span>
        </button>
      </div>
    </form>

    <!-- Right Controls (Desktop & Mobile Toggler) -->
    <div class="d-flex align-items-center gap-2">
      <!-- Desktop Navigation Links -->
      <div class="nav-links-wrapper d-none d-lg-flex align-items-center">
        <a class="nav-link-item" href="/listings">
          <i class="fa-solid fa-compass me-1 text-primary"></i>Explore
        </a>
        <a class="nav-link-item" href="/ai-planner">
          <i class="fa-solid fa-wand-magic-sparkles me-1 text-warning"></i>AI Planner
        </a>
        <a class="nav-link-item" href="/trips">
          <i class="fa-solid fa-users-viewfinder me-1 text-info"></i>Trips
        </a>

        <% if (user) { %>
          <a class="nav-link-item" href="/wishlist">
            <i class="fa-regular fa-heart me-1 text-danger"></i>Wishlist
          </a>

          <% if (user.role === 'host') { %>
            <a class="nav-link-item nav-host-badge" href="/dashboard/host">
              <i class="fa-solid fa-house-chimney me-1 text-success"></i>Host Panel
            </a>
          <% } else if (user.role === 'admin') { %>
            <a class="nav-link-item nav-host-badge" href="/dashboard/admin">
              <i class="fa-solid fa-shield-halved me-1 text-primary"></i>Admin
            </a>
          <% } else { %>
            <a class="nav-link-item" href="/become-host">
              <i class="fa-solid fa-house-flag me-1 text-primary"></i>Become a Host
            </a>
          <% } %>

          <!-- User Menu Dropdown -->
          <div class="dropdown ms-2">
            <button 
              class="nav-user-pill dropdown-toggle" 
              type="button" 
              id="userMenuBtn" 
              data-bs-toggle="dropdown" 
              aria-expanded="false"
              aria-label="User navigation menu"
            >
              <i class="fa-solid fa-bars nav-bars-icon"></i>
              <div class="nav-avatar-wrapper" id="navAvatarWrapper">
                <% 
                  const hasCustomAvatar = user.avatar && !user.avatar.includes('photo-1535713875002-d1d0cf377fde');
                  const userInitials = (user.firstName ? (user.firstName[0] + (user.lastName ? user.lastName[0] : '')).toUpperCase() : (user.username ? user.username.slice(0, 2).toUpperCase() : 'WS'));
                %>
                <img 
                  id="navbarUserAvatarImg"
                  src="<%= user.avatar || '' %>" 
                  alt="<%= user.username %>" 
                  class="avatar-img <%= !hasCustomAvatar ? 'd-none' : '' %>"
                />
                <div id="navbarUserAvatarInitials" class="avatar-initials-badge <%= hasCustomAvatar ? 'd-none' : '' %>">
                  <%= userInitials %>
                </div>
              </div>
              <span class="d-none d-xl-inline fw-bold ms-1 text-truncate" style="max-width: 110px;"><%= user.username %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2 mt-2 dropdown-menu-lux" aria-labelledby="userMenuBtn">
              <li>
                <div class="px-3 py-2 border-bottom mb-1">
                  <div class="d-flex align-items-center justify-content-between">
                    <span class="fw-bold text-truncate"><%= user.fullName || user.username %></span>
                    <% if (user.role === 'host') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Host</span>
                    <% } else if (user.role === 'admin') { %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">Admin</span>
                    <% } else { %>
                      <span class="badge bg-body-tertiary text-body border rounded-pill">Traveler</span>
                    <% } %>
                  </div>
                  <div class="small text-muted text-truncate"><%= user.email %></div>
                </div>
              </li>
              <li><a class="dropdown-item rounded-3 fw-semibold text-primary" href="/profile"><i class="fa-solid fa-circle-user me-2"></i>My Profile</a></li>
              <li><a class="dropdown-item rounded-3" href="/dashboard"><i class="fa-solid fa-gauge me-2 text-muted"></i>Dashboard</a></li>
              
              <% if (user.role === 'host') { %>
                <li><a class="dropdown-item rounded-3" href="/dashboard/host"><i class="fa-solid fa-house-chimney-user me-2 text-success"></i>Host Dashboard</a></li>
                <li><a class="dropdown-item rounded-3" href="/listings/new"><i class="fa-solid fa-circle-plus me-2 text-primary"></i>Add New Listing</a></li>
              <% } else if (user.role === 'admin') { %>
                <li><a class="dropdown-item rounded-3" href="/dashboard/admin"><i class="fa-solid fa-shield-halved me-2 text-primary"></i>Admin Dashboard</a></li>
              <% } else { %>
                <li><a class="dropdown-item rounded-3" href="/become-host"><i class="fa-solid fa-house-flag me-2 text-primary"></i>Become a Host</a></li>
              <% } %>
              
              <li><a class="dropdown-item rounded-3" href="/bookings/history"><i class="fa-solid fa-suitcase me-2 text-muted"></i>My Bookings</a></li>
              <li><a class="dropdown-item rounded-3" href="/wishlist"><i class="fa-regular fa-heart me-2 text-muted"></i>Wishlist</a></li>
              <li><a class="dropdown-item rounded-3" href="/profile#security"><i class="fa-solid fa-gear me-2 text-muted"></i>Account Settings</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item rounded-3 text-danger" href="/logout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Log out</a></li>
            </ul>
          </div>
        <% } else { %>
          <a class="nav-link-item d-none d-md-inline" href="/signup?role=host">Become a Host</a>
          <a class="btn btn-outline-secondary btn-sm rounded-pill px-3 ms-2" href="/login">Log in</a>
          <a class="btn btn-primary btn-sm rounded-pill px-3 ms-1" href="/signup">Sign up</a>
        <% } %>

        <!-- Dark Mode Toggle Button -->
        <button id="theme-toggle" class="theme-toggle-btn ms-2" title="Toggle dark / light theme" aria-label="Toggle theme">
          <i class="fa-solid fa-moon theme-icon"></i>
        </button>
      </div>

      <!-- Mobile Right Controls: Dark Mode + Drawer Toggle -->
      <div class="d-flex d-lg-none align-items-center gap-2">
        <button id="theme-toggle-mobile" class="theme-toggle-btn" title="Toggle theme" aria-label="Toggle theme">
          <i class="fa-solid fa-moon theme-icon"></i>
        </button>

        <button 
          class="btn btn-icon-round border-0" 
          type="button" 
          data-bs-toggle="offcanvas" 
          data-bs-target="#mobileNavOffcanvas" 
          aria-controls="mobileNavOffcanvas"
          aria-label="Open mobile navigation menu"
        >
          <i class="fa-solid fa-bars-staggered fs-5"></i>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- ==========================================
     MOBILE NAVIGATION DRAWER (OFFCANVAS)
     ========================================== -->
<div class="offcanvas offcanvas-end mobile-nav-drawer border-0" tabindex="-1" id="mobileNavOffcanvas" aria-labelledby="mobileNavLabel">
  <div class="offcanvas-header p-4 border-bottom">
    <div id="mobileNavLabel">
      <%- include('../components/logo.ejs', { variant: 'mobile', size: 'sm' }) %>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>

  <div class="offcanvas-body p-4 d-flex flex-column justify-content-between">
    <div>
      <!-- User Profile Card in Drawer (if logged in) -->
      <% if (user) { %>
        <div class="mobile-drawer-user-card p-3 rounded-4 mb-4 glass-card">
          <div class="d-flex align-items-center gap-3">
            <div class="nav-avatar-wrapper" style="width: 44px; height: 44px;">
              <% 
                const hasMobileAvatar = user.avatar && !user.avatar.includes('photo-1535713875002-d1d0cf377fde');
                const mInitials = (user.firstName ? (user.firstName[0] + (user.lastName ? user.lastName[0] : '')).toUpperCase() : (user.username ? user.username.slice(0, 2).toUpperCase() : 'WS'));
              %>
              <img 
                src="<%= user.avatar || '' %>" 
                alt="<%= user.username %>" 
                class="avatar-img <%= !hasMobileAvatar ? 'd-none' : '' %>"
              />
              <div class="avatar-initials-badge <%= hasMobileAvatar ? 'd-none' : '' %>">
                <%= mInitials %>
              </div>
            </div>
            <div class="flex-grow-1 overflow-hidden">
              <div class="fw-bold text-truncate"><%= user.fullName || user.username %></div>
              <div class="small text-muted text-truncate"><%= user.email %></div>
            </div>
            <% if (user.role === 'host') { %>
              <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Host</span>
            <% } %>
          </div>
          <div class="mt-3 pt-2 border-top d-flex gap-2">
            <a href="/profile" class="btn btn-outline-primary btn-sm rounded-pill flex-grow-1">My Profile</a>
            <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">Logout</a>
          </div>
        </div>
      <% } else { %>
        <!-- Guest CTA inside Drawer -->
        <div class="p-3 rounded-4 mb-4 glass-card text-center">
          <h6 class="fw-bold mb-1">Welcome to WanderStay</h6>
          <p class="text-muted small mb-3">Sign in to save properties, book stays, and plan trips.</p>
          <div class="d-grid gap-2">
            <a href="/login" class="btn btn-outline-secondary rounded-pill">Log in</a>
            <a href="/signup" class="btn btn-primary rounded-pill">Create an account</a>
          </div>
        </div>
      <% } %>

      <!-- Mobile Search Input -->
      <form class="mb-4" action="/listings" method="GET">
        <div class="input-group">
          <span class="input-group-text bg-body-tertiary border-end-0 rounded-start-pill text-muted ps-3">
            <i class="fa-solid fa-magnifying-glass"></i>
          </span>
          <input 
            type="search" 
            name="q" 
            class="form-control border-start-0 rounded-end-pill py-2" 
            placeholder="Search stays or places..." 
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          />
        </div>
      </form>

      <!-- Mobile Navigation Links List -->
      <nav class="mobile-nav-links d-flex flex-column gap-2">
        <a href="/listings" class="mobile-nav-item">
          <i class="fa-solid fa-compass text-primary"></i>
          <span>Explore Stays</span>
        </a>
        <a href="/ai-planner" class="mobile-nav-item">
          <i class="fa-solid fa-wand-magic-sparkles text-warning"></i>
          <span>AI Itinerary Planner</span>
        </a>
        <a href="/trips" class="mobile-nav-item">
          <i class="fa-solid fa-users-viewfinder text-info"></i>
          <span>Group Trips & Splits</span>
        </a>

        <% if (user) { %>
          <a href="/wishlist" class="mobile-nav-item">
            <i class="fa-regular fa-heart text-danger"></i>
            <span>Saved Wishlist</span>
          </a>
          <a href="/bookings/history" class="mobile-nav-item">
            <i class="fa-solid fa-suitcase text-secondary"></i>
            <span>My Bookings</span>
          </a>
          <a href="/dashboard" class="mobile-nav-item">
            <i class="fa-solid fa-gauge text-muted"></i>
            <span>User Dashboard</span>
          </a>

          <% if (user.role === 'host') { %>
            <a href="/dashboard/host" class="mobile-nav-item">
              <i class="fa-solid fa-house-chimney-user text-success"></i>
              <span>Host Management</span>
            </a>
            <a href="/listings/new" class="mobile-nav-item">
              <i class="fa-solid fa-circle-plus text-primary"></i>
              <span>Add New Listing</span>
            </a>
          <% } else if (user.role === 'admin') { %>
            <a href="/dashboard/admin" class="mobile-nav-item">
              <i class="fa-solid fa-shield-halved text-primary"></i>
              <span>Admin Dashboard</span>
            </a>
          <% } else { %>
            <a href="/become-host" class="mobile-nav-item">
              <i class="fa-solid fa-house-flag text-primary"></i>
              <span>Become a Host</span>
            </a>
          <% } %>

          <a href="/profile#security" class="mobile-nav-item">
            <i class="fa-solid fa-gear text-muted"></i>
            <span>Account Settings</span>
          </a>
        <% } else { %>
          <a href="/signup?role=host" class="mobile-nav-item">
            <i class="fa-solid fa-house-flag text-primary"></i>
            <span>Become a Host</span>
          </a>
        <% } %>
      </nav>
    </div>

    <!-- Mobile Drawer Footer -->
    <div class="pt-4 border-top text-center text-muted small">
      <div class="mb-1"><strong>WanderStay</strong> • Extraordinary Accommodations</div>
      <div>&copy; <%= new Date().getFullYear() %> WanderStay, Inc.</div>
    </div>
  </div>
</div>