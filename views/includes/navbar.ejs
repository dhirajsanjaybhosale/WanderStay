<link rel="stylesheet" href="/css/style.css">
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button 
        class="navbar-toggler" 
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNavAltMarkup" >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>



      <style>
  .search-btn {
    background-color: #fe424d;
    color: white;
    border-radius: 2rem;
    padding: 0 1rem 0 1rem;
  }

  .search-btn:hover {
    background-color: #fe424d;
    color: white;
  }
  .search-btn i {
    display: inline;
  }
  .search-inp {
    border-radius: 2rem;
    padding: 0.5rem 3rem 0.5rem 3rem;
    font-size: 1rem;
  }
 </style>

      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search">
        <input class="form-control me-2 search-inp" type="search" placeholder="Search destinations" />
        <button class="btn search-btn" type="submit" src="listings/search">
          <i class="fa-solid fa-magnifying-glass"></i>Search
        </button>
    </form>
      </div>

      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">LivinnHost</a>
        <% if(!CurrUser) { %>
        <a class="nav-link "  href="/signup"><b>Sign up</b></a>
        <a class="nav-link" href="/login"><b>Log in</b></a>
        <%} %>
        <% if(CurrUser) { %>
        <a class="nav-link" href="/logout"><b>Log out</b></a>
         <%} %>
       
      </div>
    </div>
  </div>
</nav>












<style>
  /* ================= NAVBAR ================= */
.navbar {
  background-color: #fff;
  z-index: 1000;
}

.navbar-brand i {
  font-size: 1.6rem;
  color: #fe424d;
}

.nav-link {
  font-weight: 500;
  color: #222 !important;
}

.nav-link:hover {
  color: #fe424d !important;
}

/* ================= SEARCH BAR ================= */
.search-inp {
  border-radius: 2rem;
  padding: 0.5rem 3rem;
  font-size: 0.95rem;
  min-width: 220px;
}

.search-btn {
  background-color: #fe424d;
  color: #fff;
  border-radius: 2rem;
  padding: 0 1.2rem;
  font-weight: 500;
}

.search-btn:hover {
  background-color: #fe424d;
  color: #fff;
}

/* ================= DESKTOP ================= */
@media (min-width: 992px) {
  .navbar-nav.ms-auto form {
    margin-right: 1.5rem;
  }
}

/* ================= TABLET (≤ 992px) ================= */
@media (max-width: 992px) {
  .search-inp {
    min-width: 180px;
  }
}

/* ================= MOBILE (≤ 768px) ================= */
@media (max-width: 768px) {
  .navbar-collapse {
    background: #fff;
    padding: 12px;
    border-radius: 12px;
  }

  .navbar-nav {
    gap: 8px;
  }

  .search-inp {
    width: 100%;
    margin-bottom: 8px;
  }

  .search-btn {
    width: 100%;
  }

  .navbar-nav.ms-auto {
    align-items: flex-start;
  }
}

/* ================= SMALL PHONES (≤ 480px) ================= */
@media (max-width: 480px) {
  .navbar-brand i {
    font-size: 1.4rem;
  }

  .nav-link {
    font-size: 0.9rem;
  }
}

</style>