<% if (success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm rounded-4 border-0 mb-4" role="alert">
    <i class="fa-solid fa-circle-check fs-5 me-2 text-success"></i>
    <div class="flex-grow-1 fw-semibold"><%= success %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (error && error.length) { %>
  <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm rounded-4 border-0 mb-4" role="alert">
    <i class="fa-solid fa-circle-exclamation fs-5 me-2 text-danger"></i>
    <div class="flex-grow-1 fw-semibold"><%= error %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>