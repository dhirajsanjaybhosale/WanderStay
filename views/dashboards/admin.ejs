<% layout('/layouts/boilerplate.ejs') %>

<div class="container-max my-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h2 class="dashboard-title mb-1">Admin Dashboard</h2>
      <p class="text-muted mb-0">Platform overview of hosts, travelers, listings, and community reviews</p>
    </div>
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createHostModal">
        <i class="fa-solid fa-user-plus me-1"></i> Add New Host
      </button>
      <a href="/listings/new" class="btn btn-outline-dark rounded-pill px-3">
        <i class="fa-solid fa-plus me-1"></i> Add Listing
      </a>
    </div>
  </div>

  <% 
    const hostsList = users.filter(u => u.role === 'host');
    const guestsList = users.filter(u => u.role === 'guest' || !u.role);
    const adminList = users.filter(u => u.role === 'admin');
  %>

  <!-- Metric Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="stat-card-widget">
        <div class="stat-icon-box" style="background: #EEF2FF; color: #4F46E5;">
          <i class="fa-solid fa-users"></i>
        </div>
        <div>
          <div class="stat-number"><%= users.length %></div>
          <div class="stat-title">Total Users</div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="stat-card-widget">
        <div class="stat-icon-box" style="background: #DCFCE7; color: #166534;">
          <i class="fa-solid fa-house-chimney-user"></i>
        </div>
        <div>
          <div class="stat-number"><%= hostsList.length %></div>
          <div class="stat-title">Active Hosts</div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="stat-card-widget">
        <div class="stat-icon-box" style="background: #FEF3C7; color: #92400E;">
          <i class="fa-solid fa-house-laptop"></i>
        </div>
        <div>
          <div class="stat-number"><%= listings.length %></div>
          <div class="stat-title">Total Listings</div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="stat-card-widget">
        <div class="stat-icon-box" style="background: #FEE2E2; color: #991B1B;">
          <i class="fa-solid fa-star"></i>
        </div>
        <div>
          <div class="stat-number"><%= reviews.length %></div>
          <div class="stat-title">Total Reviews</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Users Table Card -->
  <div class="card border rounded-4 shadow-sm bg-white p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
      <div>
        <h4 class="fw-bold mb-0">Platform Users &amp; Hosts</h4>
        <div class="small text-muted">Manage roles and permissions across travelers and property hosts</div>
      </div>
      <div class="d-flex gap-2">
        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
          <i class="fa-solid fa-circle-check me-1"></i> <%= hostsList.length %> Hosts
        </span>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
          <%= guestsList.length %> Travelers
        </span>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table-custom align-middle">
        <thead>
          <tr>
            <th>User / Host</th>
            <th>Email</th>
            <th>Role</th>
            <th>Manage Role</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-3">
                  <img 
                    src="<%= u.avatar || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=80&q=80' %>" 
                    alt="<%= u.username %>" 
                    class="avatar-img rounded-circle" 
                    style="width: 44px; height: 44px; object-fit: cover;"
                  />
                  <div>
                    <div class="fw-bold text-dark">
                      <%= (u.firstName || u.lastName) ? (u.firstName + ' ' + u.lastName) : u.username %>
                    </div>
                    <div class="small text-muted">@<%= u.username %></div>
                  </div>
                </div>
              </td>
              <td class="text-secondary"><%= u.email %></td>
              <td>
                <% if (u.role === 'host') { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill fw-semibold">
                    <i class="fa-solid fa-house-chimney-user me-1"></i> Host
                  </span>
                <% } else if (u.role === 'admin') { %>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill fw-semibold">
                    <i class="fa-solid fa-shield-halved me-1"></i> Admin
                  </span>
                <% } else { %>
                  <span class="badge bg-secondary-subtle text-secondary border px-3 py-1 rounded-pill">
                    <i class="fa-solid fa-user me-1"></i> Traveler
                  </span>
                <% } %>
              </td>
              <td>
                <form action="/dashboard/admin/users/<%= u._id %>/role" method="POST" class="d-inline-flex align-items-center gap-2">
                  <select name="role" class="form-select form-select-sm rounded-pill" style="min-width: 120px;" onchange="this.form.submit()">
                    <option value="guest" <%= (u.role === 'guest' || !u.role) ? 'selected' : '' %>>Traveler</option>
                    <option value="host" <%= u.role === 'host' ? 'selected' : '' %>>Host</option>
                    <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                  </select>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Recent Reviews Table -->
  <div class="card border rounded-4 shadow-sm bg-white p-4">
    <h4 class="fw-bold mb-3">Community Reviews</h4>
    <% if (reviews.length === 0) { %>
      <p class="text-muted">No reviews found.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table-custom">
          <thead>
            <tr>
              <th>Author</th>
              <th>Rating</th>
              <th>Comment</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% reviews.slice(0, 15).forEach(function(r) { %>
              <tr>
                <td><strong><%= r.author && r.author.username ? r.author.username : 'User' %></strong></td>
                <td>
                  <span class="badge bg-warning-subtle text-dark border px-2 py-1">
                    <i class="fa-solid fa-star text-warning me-1"></i><%= r.rating %>/5
                  </span>
                </td>
                <td class="text-muted"><%= r.comment %></td>
                <td class="small text-muted"><%= r.createdAt ? new Date(r.createdAt).toLocaleDateString() : '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<!-- Modal: Create New Host -->
<div class="modal fade" id="createHostModal" tabindex="-1" aria-labelledby="createHostModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold" id="createHostModalLabel">
          <i class="fa-solid fa-house-chimney-user text-primary me-2"></i>Create New Host
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-2">
        <p class="text-muted small mb-3">Add a new host account with host role privileges and property ownership permissions.</p>
        <form action="/dashboard/admin/hosts" method="POST" class="needs-validation" novalidate>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label small fw-semibold">First Name</label>
              <input type="text" name="firstName" class="form-control rounded-3" placeholder="e.g. Alex" />
            </div>
            <div class="col-6">
              <label class="form-label small fw-semibold">Last Name</label>
              <input type="text" name="lastName" class="form-control rounded-3" placeholder="e.g. Vance" />
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Username *</label>
            <input type="text" name="username" class="form-control rounded-3" placeholder="e.g. wander_villas" required />
            <div class="invalid-feedback">Username is required.</div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Email Address *</label>
            <input type="email" name="email" class="form-control rounded-3" placeholder="e.g. host@wanderstay.com" required />
            <div class="invalid-feedback">Valid email is required.</div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Password (default: password123)</label>
            <input type="password" name="password" class="form-control rounded-3" placeholder="Min 6 characters" minlength="6" value="password123" />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Host Bio / Specialization</label>
            <textarea name="bio" class="form-control rounded-3" rows="2" placeholder="e.g. Host of luxury beachfront villas with 5+ years experience..."></textarea>
          </div>

          <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary rounded-pill px-4">
              <i class="fa-solid fa-check me-1"></i> Create Host
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
