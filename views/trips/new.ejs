<% layout('/layouts/boilerplate.ejs') %>

<div class="row justify-content-center my-4">
  <div class="col-lg-6 col-md-8">
    <div class="card border rounded-4 p-4 p-md-5 bg-white shadow-sm">
      <div class="text-center mb-4">
        <div class="brand-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.3rem;">
          <i class="fa-solid fa-users"></i>
        </div>
        <h2 class="fw-bold mb-1">Create a Group Trip</h2>
        <p class="text-muted small">Collaborate with friends, record group expenses, and track shared balances</p>
      </div>

      <form action="/trips" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="title" class="form-label">Trip Title</label>
          <input 
            name="title" 
            id="title"
            class="form-control" 
            placeholder="e.g. Goa Weekend Getaway, Manali Snow Adventure" 
            required 
          />
          <div class="invalid-feedback">Please enter a trip name.</div>
        </div>

        <div class="mb-4">
          <label for="destination" class="form-label">Destination</label>
          <input 
            name="destination" 
            id="destination"
            class="form-control" 
            placeholder="e.g. Goa, India" 
            required 
          />
          <div class="invalid-feedback">Please specify the destination.</div>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-lg flex-grow-1 rounded-pill">
            <i class="fa-solid fa-plus me-1"></i> Create Trip
          </button>
          <a href="/trips" class="btn btn-outline-dark btn-lg rounded-pill px-4">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
