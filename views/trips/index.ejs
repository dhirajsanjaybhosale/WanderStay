<% layout('/layouts/boilerplate.ejs') %>

<div class="container-max my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">Group Trips</h2>
      <p class="text-muted mb-0">Plan trips with friends, record group expenses, and split costs seamlessly</p>
    </div>
    <a class="btn btn-primary rounded-pill px-4" href="/trips/new">
      <i class="fa-solid fa-plus me-1"></i> Create Trip
    </a>
  </div>

  <% if (trips && trips.length) { %>
    <div class="row g-4">
      <% for (let trip of trips) { %>
        <div class="col-md-6 col-lg-4">
          <div class="card border rounded-4 overflow-hidden shadow-sm h-100 bg-white">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
              <div>
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1">
                    <i class="fa-solid fa-location-dot me-1"></i><%= trip.destination %>
                  </span>
                  <span class="small text-muted"><%= (trip.members && trip.members.length) || 1 %> <%= (trip.members && trip.members.length === 1) ? 'Member' : 'Members' %></span>
                </div>
                <h4 class="fw-bold mb-2"><%= trip.title %></h4>
                <p class="text-muted small mb-3">Created by <%= trip.owner && trip.owner.username ? trip.owner.username : 'You' %></p>
              </div>

              <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted"><%= trip.createdAt ? new Date(trip.createdAt).toLocaleDateString() : '' %></span>
                <a href="/trips/<%= trip._id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                  Open Trip &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="text-center py-5 my-5 bg-white border rounded-4 shadow-sm p-4">
      <div class="brand-icon mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.8rem; background: var(--primary-light); color: var(--primary);">
        <i class="fa-solid fa-users-viewfinder"></i>
      </div>
      <h4 class="fw-bold">No group trips yet</h4>
      <p class="text-muted mb-4">Start a new group trip to collaborate with travel buddies and split expenses effortlessly.</p>
      <a href="/trips/new" class="btn btn-primary rounded-pill px-4">Create Your First Trip</a>
    </div>
  <% } %>
</div>
