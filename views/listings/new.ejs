<% layout("/layouts/boilerplate.ejs") %>

<div class="container-max py-4">
<div class="row justify-content-center my-4">
  <div class="col-lg-8 col-md-10">
    <div class="glass-card rounded-4 p-4 p-md-5">
      <div class="text-center mb-4">
        <div class="brand-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.3rem;">
          <i class="fa-solid fa-house-chimney-medical"></i>
        </div>
        <h2 class="fw-bold mb-1"><%= t('forms.createListing') %></h2>
        <p class="text-muted small"><%= t('forms.createListingDesc') %></p>
      </div>

      <form action="/listings" method="POST" class="needs-validation" novalidate enctype="multipart/form-data">
        
        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-label"><%= t('forms.propertyTitle') %></label>
          <input 
            name="listing[title]" 
            id="title" 
            type="text" 
            placeholder="e.g. Luxurious Beachfront Villa with Private Pool" 
            class="form-control" 
            required 
          />
          <div class="invalid-feedback">Please provide an attractive property title.</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label"><%= t('forms.description') %></label>
          <textarea 
            name="listing[description]" 
            id="description" 
            rows="4" 
            placeholder="Describe what makes your space special, nearby attractions, amenities, and guest experience..." 
            class="form-control" 
            required
          ></textarea>
          <div class="invalid-feedback">Please enter a description for your listing.</div>
        </div>

        <!-- Image Upload with Live Preview -->
        <div class="mb-4">
          <label for="image" class="form-label fw-bold">Property Photos</label>
          <div class="photo-upload-dropzone p-4 text-center rounded-4 border border-dashed mb-2" id="photoDropzone" style="border: 2px dashed var(--border-color); background: var(--surface-subtle); cursor: pointer;">
            <i class="fa-solid fa-cloud-arrow-up text-primary fs-2 mb-2"></i>
            <div class="fw-semibold">Click or drag photos here to upload</div>
            <div class="text-muted small">Supports high-res JPG, PNG, WEBP (Multiple allowed)</div>
            <input 
              name="listing[image]" 
              id="image" 
              type="file" 
              class="form-control d-none" 
              accept="image/*"
              multiple
            />
          </div>
          <!-- Preview container -->
          <div id="imagePreviewContainer" class="d-flex flex-wrap gap-2 mt-2"></div>
        </div>

        <!-- Price & Category -->
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="price" class="form-label"><%= t('forms.pricePerNight') %></label>
            <div class="input-group">
              <span class="input-group-text bg-body-tertiary text-body fw-bold border-theme">&#8377;</span>
              <input 
                name="listing[price]" 
                id="price" 
                type="number" 
                min="100" 
                placeholder="2500" 
                class="form-control" 
                required 
              />
            </div>
            <div class="invalid-feedback">Please enter a valid price.</div>
          </div>

          <div class="col-md-6">
            <label for="category" class="form-label"><%= t('forms.category') %></label>
            <select name="listing[category]" id="category" class="form-select" required>
              <option value="" disabled selected>Select category...</option>
              <option value="Beach">🏖 Beachfront</option>
              <option value="City">🏙 City Apartment</option>
              <option value="Mountain">🏔 Mountain Retreat</option>
              <option value="Lake">🌊 Lakehouse</option>
              <option value="Ski">⛷️ Ski Resort</option>
              <option value="Desert">🏜️ Desert Oasis</option>
              <option value="Cabin">🏡 Cozy Cabin</option>
              <option value="Villa">💎 Luxury Villa</option>
            </select>
            <div class="invalid-feedback">Please select a category.</div>
          </div>
        </div>

        <!-- Host Dynamic Pricing Management Section -->
        <%- include("../includes/host-pricing-section.ejs") %>

        <!-- Location & Country -->
        <div class="row g-3 mb-4">
          <div class="col-md-7">
            <label for="location" class="form-label"><%= t('forms.location') %></label>
            <input 
              name="listing[location]" 
              id="location" 
              type="text" 
              placeholder="e.g. Candolim, Goa" 
              class="form-control" 
              required 
            />
            <div class="invalid-feedback">Please specify the location.</div>
          </div>

          <div class="col-md-5">
            <label for="country" class="form-label"><%= t('forms.country') %></label>
            <input 
              name="listing[country]" 
              id="country" 
              type="text" 
              placeholder="e.g. India" 
              class="form-control" 
              required 
            />
            <div class="invalid-feedback">Please specify the country.</div>
          </div>
        </div>

        <!-- Available Amenities Selection -->
        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <label class="form-label fw-bold mb-0">
              <i class="fa-solid fa-list-check text-primary me-1"></i> Property Amenities
            </label>
            <span class="text-muted small">Select all that your space offers</span>
          </div>
          
          <div class="amenity-select-grid">
            <% const amenitiesList = (typeof allAmenities !== 'undefined' && allAmenities) ? allAmenities : []; %>
            <% amenitiesList.forEach((amenity, idx) => { %>
              <div class="amenity-checkbox-wrapper">
                <input 
                  type="checkbox" 
                  name="listing[amenities][]" 
                  value="<%= amenity.name %>" 
                  id="amenity_new_<%= idx %>" 
                  class="btn-check" 
                />
                <label class="amenity-select-label" for="amenity_new_<%= idx %>">
                  <div class="d-flex justify-content-between align-items-center w-100">
                    <i class="<%= amenity.icon %> amenity-select-icon"></i>
                    <span class="amenity-select-check-indicator"><i class="fa-solid fa-check"></i></span>
                  </div>
                  <div class="amenity-select-title"><%= amenity.name %></div>
                </label>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Cancellation Policy Selection -->
        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <label class="form-label fw-bold mb-0">
              <i class="fa-solid fa-clock-rotate-left text-primary me-1"></i> Cancellation Policy *
            </label>
            <span class="text-muted small">Choose the refund rules for guest cancellations</span>
          </div>

          <div class="row g-2">
            <div class="col-md-4">
              <input type="radio" class="btn-check" name="listing[cancellationPolicy]" id="policy_flexible" value="Flexible" checked>
              <label class="btn btn-outline-secondary w-100 text-start p-3 rounded-4 h-100" for="policy_flexible">
                <div class="d-flex align-items-center justify-content-between mb-1">
                  <span class="fw-bold text-success"><i class="fa-solid fa-feather-pointed me-1"></i> Flexible</span>
                  <span class="badge bg-success-subtle text-success rounded-pill px-2 py-0.5 small">Popular</span>
                </div>
                <div class="small text-muted" style="font-size: 0.76rem;">100% refund up to 24h before check-in. 50% refund within 24h.</div>
              </label>
            </div>

            <div class="col-md-4">
              <input type="radio" class="btn-check" name="listing[cancellationPolicy]" id="policy_moderate" value="Moderate">
              <label class="btn btn-outline-secondary w-100 text-start p-3 rounded-4 h-100" for="policy_moderate">
                <div class="d-flex align-items-center justify-content-between mb-1">
                  <span class="fw-bold text-warning-emphasis"><i class="fa-solid fa-scale-balanced me-1"></i> Moderate</span>
                  <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2 py-0.5 small">Balanced</span>
                </div>
                <div class="small text-muted" style="font-size: 0.76rem;">100% refund up to 5 days before check-in. 50% up to 24h.</div>
              </label>
            </div>

            <div class="col-md-4">
              <input type="radio" class="btn-check" name="listing[cancellationPolicy]" id="policy_strict" value="Strict">
              <label class="btn btn-outline-secondary w-100 text-start p-3 rounded-4 h-100" for="policy_strict">
                <div class="d-flex align-items-center justify-content-between mb-1">
                  <span class="fw-bold text-danger"><i class="fa-solid fa-shield-halved me-1"></i> Strict</span>
                  <span class="badge bg-danger-subtle text-danger rounded-pill px-2 py-0.5 small">Protection</span>
                </div>
                <div class="small text-muted" style="font-size: 0.76rem;">Full refund within 48h of booking & 14+ days before arrival. 50% up to 7 days.</div>
              </label>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-lg flex-grow-1 rounded-pill">
            <i class="fa-solid fa-plus me-1"></i> <%= t('buttons.publishListing') %>
          </button>
          <a href="/listings" class="btn btn-outline-secondary btn-lg rounded-pill px-4"><%= t('buttons.cancel') %></a>
        </div>
      </form>
    </div>
  </div>
</div>
</div>

<script>
  (function() {
    const dropzone = document.getElementById('photoDropzone');
    const input = document.getElementById('image');
    const previewContainer = document.getElementById('imagePreviewContainer');

    if (dropzone && input) {
      dropzone.addEventListener('click', () => input.click());

      input.addEventListener('change', () => {
        previewContainer.innerHTML = '';
        const files = Array.from(input.files || []);
        files.forEach(file => {
          if (file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = (e) => {
              const imgWrap = document.createElement('div');
              imgWrap.className = 'position-relative rounded-3 overflow-hidden shadow-xs border';
              imgWrap.style.width = '90px';
              imgWrap.style.height = '70px';
              imgWrap.innerHTML = `<img src="${e.target.result}" style="width: 100%; height: 100%; object-fit: cover;" alt="Preview" />`;
              previewContainer.appendChild(imgWrap);
            };
            reader.readAsDataURL(file);
          }
        });
      });
    }
  })();
</script>