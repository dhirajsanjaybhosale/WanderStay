<% layout('/layouts/boilerplate.ejs') %>
  <% const user=(typeof currUser !=='undefined' && currUser) ? currUser : ((typeof CurrUser !=='undefined' && CurrUser)
    ? CurrUser : null); %>

    <div class="container-max py-4">
      <div class="property-header mt-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3">
          <div>
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill">
                <%= listing.category %>
              </span>
              <span class="text-muted"><i class="fa-solid fa-location-dot travel-pin-pulse text-primary me-1"></i>
                <%= listing.location %>, <%= listing.country %>
              </span>
            </div>
            <h1 class="property-title">
              <%= listing.title %>
            </h1>
            <div class="property-meta">
              <span>
                <i class="fa-solid fa-star text-warning"></i>
                <strong>
                  <%= listing.averageRating ? listing.averageRating.toFixed(1) : 'New' %>
                </strong>
              </span>
              <span>•</span>
              <span>
                <%= listing.reviews ? listing.reviews.length : 0 %>
                  <%= listing.reviews && listing.reviews.length===1 ? 'review' : 'reviews' %>
              </span>
              <span>•</span>
              <span>Hosted by <strong>
                  <%= listing.owner && (listing.owner.firstName ? (listing.owner.firstName + ' ' +
                    listing.owner.lastName) : listing.owner.username) ? (listing.owner.firstName ?
                    (listing.owner.firstName + ' ' + listing.owner.lastName) : listing.owner.username)
                    : 'WanderStay Host' %>
                </strong>
                <% if (listing.owner && listing.owner.superhost && listing.owner.superhost.isSuperhost) { %>
                  <span class="badge-superhost ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= listing.owner.superhost.badgeReason || '⭐ Superhost: Demonstrates extraordinary hospitality, stellar guest reviews, and reliability.' %>">
                    ⭐ Superhost
                  </span>
                <% } %>
                <% if (listing.owner && listing.owner.hostVerification && listing.owner.hostVerification.status === 'verified') { %>
                  <span class="badge-verified-host ms-1"><i class="fa-solid fa-circle-check"></i> ✓ Verified Host</span>
                <% } %>
              </span>
            </div>
          </div>

          <!-- Wishlist Button -->
          <form action="/wishlist/<%= listing._id %>/toggle" method="POST" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary rounded-pill px-4" aria-label="Toggle wishlist">
              <i class="fa-<%= isWishlisted ? 'solid' : 'regular' %> fa-heart text-danger me-1"></i>
              <%= isWishlisted ? 'Saved' : 'Save to Wishlist' %>
            </button>
          </form>
        </div>
      </div>

      <!-- Cinematic Property Gallery Mosaic -->
      <% 
        const photosList = (typeof galleryPhotos !== 'undefined' && Array.isArray(galleryPhotos) && galleryPhotos.length > 0)
          ? galleryPhotos
          : [{
              original: (listing.image && listing.image.url) || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=85',
              hero: (listing.image && listing.image.url) || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80',
              thumb: (listing.image && listing.image.url) || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=360&q=75',
              full: (listing.image && listing.image.url) || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1920&q=90'
            }];
        const hasMultiple = photosList.length > 1;
        const mainPhoto = photosList[0];
      %>

      <section class="property-gallery-mosaic <%= hasMultiple ? 'has-multi-photos' : '' %> reveal-on-scroll">
        <!-- Main Primary Hero -->
        <div class="gallery-main-hero" id="galleryMainHero" title="Click to open full-screen viewer">
          <img 
            id="main-gallery-img" 
            src="<%= mainPhoto.hero %>" 
            alt="<%= listing.title %>" 
            fetchpriority="high"
            loading="eager"
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80';"
          />
          <div class="gallery-hero-badge">
            <i class="fa-solid fa-expand me-1"></i> Full Screen
          </div>
          <% if (hasMultiple) { %>
            <div class="gallery-mobile-counter d-md-none">
              <i class="fa-solid fa-camera me-1"></i> 1 / <%= photosList.length %>
            </div>
          <% } %>
        </div>

        <!-- Side Thumbnails (Desktop/Tablet) -->
        <% if (hasMultiple) { %>
          <div class="gallery-side-mosaic d-none d-md-grid">
            <div class="gallery-side-thumb" data-index="1" title="View photo 2">
              <img 
                src="<%= photosList[1] ? photosList[1].hero : mainPhoto.hero %>" 
                alt="<%= listing.title %> photo 2" 
                loading="lazy"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80';"
              />
            </div>
            <div class="gallery-side-thumb" data-index="<%= Math.min(2, photosList.length - 1) %>" title="View photo 3">
              <img 
                src="<%= photosList[2] ? photosList[2].hero : (photosList[1] ? photosList[1].hero : mainPhoto.hero) %>" 
                alt="<%= listing.title %> photo 3" 
                loading="lazy"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80';"
              />
            </div>

            <!-- View All Photos Action Button -->
            <button type="button" class="gallery-view-all-pill open-gallery-modal-trigger" id="viewAllPhotosBtn">
              <i class="fa-solid fa-grip-vertical"></i> Show all <%= photosList.length %> photos
            </button>
          </div>
        <% } %>
      </section>

      <!-- Interactive Thumbnail Strip -->
      <% if (hasMultiple) { %>
        <div class="gallery-interactive-strip reveal-on-scroll">
          <% photosList.forEach((p, idx) => { %>
            <button 
              type="button" 
              class="gallery-interactive-thumb <%= idx === 0 ? 'active' : '' %>" 
              data-index="<%= idx %>" 
              aria-label="View photo <%= idx + 1 %> of <%= photosList.length %>"
            >
              <img 
                src="<%= p.thumb %>" 
                alt="<%= listing.title %> thumbnail <%= idx + 1 %>" 
                loading="lazy"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=360&q=75';"
              />
            </button>
          <% }) %>
        </div>
      <% } %>

        <!-- Content Grid: Details Left, Booking Card Right -->
        <div class="row g-5">
          <!-- Left Details Column -->
          <div class="col-lg-7 col-xl-8">
            <!-- Host Information Card -->
            <div class="host-card d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
              <div class="d-flex align-items-center gap-3">
                <img
                  src="<%= (listing.owner && listing.owner.avatar) || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=120&q=80' %>"
                  alt="Host avatar" class="host-avatar" />
                <div>
                  <h5 class="fw-bold mb-1 d-flex align-items-center gap-2 flex-wrap">
                    <span>Hosted by <%= listing.owner ? (listing.owner.fullName || listing.owner.username) : 'WanderStay Host' %></span>
                    <% if (listing.owner && listing.owner.superhost && listing.owner.superhost.isSuperhost) { %>
                      <span class="badge-superhost" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= listing.owner.superhost.badgeReason || '⭐ Superhost: Demonstrates extraordinary hospitality, stellar guest reviews, and reliability.' %>">
                        ⭐ Superhost
                      </span>
                    <% } %>
                    <% if (listing.owner && listing.owner.hostVerification && listing.owner.hostVerification.status === 'verified') { %>
                      <span class="badge-verified-host" title="WanderStay Identity Verified Host">
                        <i class="fa-solid fa-circle-check"></i> ✓ Verified Host
                      </span>
                    <% } %>
                  </h5>
                  <div class="small text-muted">
                    <% if (listing.owner && listing.owner.superhost && listing.owner.superhost.isSuperhost) { %>
                      <i class="fa-solid fa-star text-warning me-1"></i>Official Superhost • 
                    <% } else if (listing.owner && listing.owner.hostVerification && listing.owner.hostVerification.status === 'verified') { %>
                      <i class="fa-solid fa-shield-check text-success me-1"></i>Identity Verified Host • 
                    <% } else { %>
                      <i class="fa-solid fa-house-user text-primary me-1"></i>Property Host • 
                    <% } %>
                    <%= (listing.owner && listing.owner.bio) ? listing.owner.bio : 'Experienced host dedicated to memorable guest stays.' %>
                  </div>
                </div>
              </div>

              <% if (user && listing.owner && (!user._id.equals(listing.owner._id))) { %>
                <a href="/messages/new?listingId=<%= listing._id %>" class="btn btn-outline-primary rounded-pill px-4 text-nowrap">
                  <i class="fa-regular fa-message me-1"></i> Contact Host
                </a>
              <% } else if (!user) { %>
                <a href="/login" class="btn btn-outline-primary rounded-pill px-4 text-nowrap">
                  <i class="fa-regular fa-message me-1"></i> Contact Host
                </a>
              <% } %>
            </div>

            <!-- Property Key Facts Strip (Guests, Bedrooms, Beds, Bathrooms, Type) -->
            <div class="property-specs-bar p-3 rounded-4 bg-body-tertiary border mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
              <div class="d-flex align-items-center gap-2">
                <div class="spec-icon-box">
                  <i class="fa-solid fa-users text-primary"></i>
                </div>
                <div>
                  <span class="small text-muted d-block">Capacity</span>
                  <strong class="text-body"><%= listing.guests || 2 %> <%= (listing.guests === 1) ? 'guest' : 'guests' %></strong>
                </div>
              </div>

              <div class="vr opacity-25 d-none d-sm-block"></div>

              <div class="d-flex align-items-center gap-2">
                <div class="spec-icon-box">
                  <i class="fa-solid fa-door-open text-primary"></i>
                </div>
                <div>
                  <span class="small text-muted d-block">Bedrooms</span>
                  <strong class="text-body"><%= listing.bedrooms || 1 %> <%= (listing.bedrooms === 1) ? 'bedroom' : 'bedrooms' %></strong>
                </div>
              </div>

              <div class="vr opacity-25 d-none d-sm-block"></div>

              <div class="d-flex align-items-center gap-2">
                <div class="spec-icon-box">
                  <i class="fa-solid fa-bed text-primary"></i>
                </div>
                <div>
                  <span class="small text-muted d-block">Beds</span>
                  <strong class="text-body"><%= listing.beds || listing.bedrooms || 1 %> <%= ((listing.beds || listing.bedrooms || 1) === 1) ? 'bed' : 'beds' %></strong>
                </div>
              </div>

              <div class="vr opacity-25 d-none d-sm-block"></div>

              <div class="d-flex align-items-center gap-2">
                <div class="spec-icon-box">
                  <i class="fa-solid fa-bath text-primary"></i>
                </div>
                <div>
                  <span class="small text-muted d-block">Baths</span>
                  <strong class="text-body"><%= listing.bathrooms || 1 %> <%= (listing.bathrooms === 1) ? 'bath' : 'baths' %></strong>
                </div>
              </div>

              <% if (listing.propertyType) { %>
                <div class="vr opacity-25 d-none d-md-block"></div>
                <div class="d-flex align-items-center gap-2">
                  <div class="spec-icon-box">
                    <i class="fa-solid fa-hotel text-primary"></i>
                  </div>
                  <div>
                    <span class="small text-muted d-block">Property Type</span>
                    <strong class="text-body"><%= listing.propertyType %></strong>
                  </div>
                </div>
              <% } %>
            </div>

            <!-- Description -->
            <div class="mb-4">
              <h4 class="fw-bold mb-3">About this space</h4>
              <p class="text-body leading-relaxed" style="white-space: pre-line; line-height: 1.7;">
                <%= listing.description %>
              </p>
            </div>

            <hr class="my-4" />

            <!-- Amenities Grid -->
            <div class="mb-4">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">What this place offers</h4>
                <% if (listing.amenities && listing.amenities.length > 0) { %>
                  <span class="badge bg-body-tertiary text-body border px-3 py-1.5 rounded-pill small">
                    <i class="fa-solid fa-list-check me-1 text-primary"></i> <%= listing.amenities.length %> Amenities
                  </span>
                <% } %>
              </div>

              <% if (listing.amenities && listing.amenities.length > 0) { %>
                <div class="amenities-show-grid">
                  <% listing.amenities.forEach(amName => { %>
                    <% const aMeta = (typeof getAmenityDetails === 'function') ? getAmenityDetails(amName) : { name: amName, icon: 'fa-solid fa-circle-check', description: 'Provided by host' }; %>
                    <div class="amenity-show-card">
                      <div class="amenity-show-icon-box">
                        <i class="<%= aMeta.icon %>"></i>
                      </div>
                      <div>
                        <div class="amenity-show-name"><%= aMeta.name %></div>
                        <div class="amenity-show-desc"><%= aMeta.description %></div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <!-- Graceful Fallback for Legacy Listings without specific amenities -->
                <div class="p-3 rounded-4 bg-body-tertiary border d-flex align-items-center gap-3">
                  <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; background: rgba(255, 56, 92, 0.08); color: var(--primary); font-size: 1.2rem;">
                    <i class="fa-solid fa-house-chimney-check"></i>
                  </div>
                  <div>
                    <div class="fw-bold text-body mb-0.5">Essential Hospitality Amenities</div>
                    <div class="small text-muted">Fresh bed linens, plush bath towels, hot water, wireless connectivity, and standard guest essentials are provided by the host.</div>
                  </div>
                </div>
              <% } %>
            </div>

            <hr class="my-4" />

            <!-- Availability Calendar Section -->
            <section id="calendar-section" class="mb-4">
              <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-2">
                <h4 class="fw-bold mb-0">Availability & Dates</h4>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 align-self-start align-self-sm-center">
                  <i class="fa-solid fa-calendar-check me-1"></i> Live Real-Time Availability
                </span>
              </div>
              <p class="text-muted small mb-3">
                Select your travel dates directly on the interactive calendar. Already booked and host-blocked dates are protected and disabled.
              </p>

              <div class="wander-calendar-card" id="wander-calendar">
                <div class="cal-header">
                  <div class="cal-title-wrap">
                    <h5 class="cal-month-title" id="cal-month-title">Calendar</h5>
                    <span class="cal-subtitle">Click an available date to begin selection</span>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <button type="button" class="cal-nav-btn" id="cal-prev-btn" aria-label="Previous Month">
                      <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button type="button" class="cal-nav-btn" id="cal-next-btn" aria-label="Next Month">
                      <i class="fa-solid fa-chevron-right"></i>
                    </button>
                  </div>
                </div>

                <!-- Weekdays Header -->
                <div class="cal-weekdays">
                  <div class="cal-weekday">Su</div>
                  <div class="cal-weekday">Mo</div>
                  <div class="cal-weekday">Tu</div>
                  <div class="cal-weekday">We</div>
                  <div class="cal-weekday">Th</div>
                  <div class="cal-weekday">Fr</div>
                  <div class="cal-weekday">Sa</div>
                </div>

                <!-- Days Grid -->
                <div class="cal-grid" id="cal-grid"></div>

                <!-- Selection Status Bar -->
                <div class="cal-status-bar">
                  <div class="cal-selected-dates" id="cal-status-text">
                    Select check-in & check-out dates on the calendar
                  </div>
                  <button type="button" class="cal-clear-btn" id="cal-clear-btn" style="display: none;">
                    Clear dates
                  </button>
                </div>

                <!-- Calendar Legend -->
                <div class="cal-legend">
                  <div class="cal-legend-item">
                    <span class="cal-dot available"></span>
                    <span>Available</span>
                  </div>
                  <div class="cal-legend-item">
                    <span class="cal-dot selected"></span>
                    <span>Selected Range</span>
                  </div>
                  <div class="cal-legend-item">
                    <span class="cal-dot booked"></span>
                    <span>Booked</span>
                  </div>
                  <div class="cal-legend-item">
                    <span class="cal-dot blocked"></span>
                    <span>Unavailable / Blocked</span>
                  </div>
                </div>

                <!-- Host Management Section (If owner) -->
                <% if (user && listing.owner && listing.owner._id && user._id && listing.owner._id.equals(user._id)) { %>
                  <div class="host-cal-management">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                      <h6 class="fw-bold mb-0 text-primary">
                        <i class="fa-solid fa-calendar-days me-1"></i> Host Date Controls & Manual Blocking
                      </h6>
                      <span class="badge bg-secondary-subtle text-secondary rounded-pill">Host Only</span>
                    </div>

                    <!-- Block Dates Form -->
                    <form action="/listings/<%= listing._id %>/block-dates" method="POST" class="row g-2 align-items-end mb-3">
                      <div class="col-md-4">
                        <label class="form-label small fw-semibold text-muted">Start Date</label>
                        <input type="date" name="startDate" class="form-control form-control-sm rounded-3" required />
                      </div>
                      <div class="col-md-4">
                        <label class="form-label small fw-semibold text-muted">End Date</label>
                        <input type="date" name="endDate" class="form-control form-control-sm rounded-3" required />
                      </div>
                      <div class="col-md-4">
                        <label class="form-label small fw-semibold text-muted">Reason (Optional)</label>
                        <div class="d-flex gap-2">
                          <input type="text" name="reason" class="form-control form-control-sm rounded-3" placeholder="Maintenance / Stay" />
                          <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3 text-nowrap">
                            <i class="fa-solid fa-lock me-1"></i> Block
                          </button>
                        </div>
                      </div>
                    </form>

                    <!-- Current Blocked Dates List -->
                    <% if (blockedDates && blockedDates.length > 0) { %>
                      <div class="pt-2 border-top">
                        <span class="small fw-semibold text-muted d-block mb-2">Active Host-Blocked Dates:</span>
                        <div class="d-flex flex-wrap gap-2">
                          <% blockedDates.forEach(b => { %>
                            <div class="host-blocked-chip">
                              <span>
                                <i class="fa-solid fa-ban text-danger me-1"></i>
                                <%= new Date(b.startDate).toLocaleDateString() %> &rarr; <%= new Date(b.endDate).toLocaleDateString() %>
                                <% if (b.reason) { %><span class="text-muted">(<%= b.reason %>)</span><% } %>
                              </span>
                              <form action="/listings/<%= listing._id %>/unblock-dates/<%= b._id %>" method="POST" class="d-inline" onsubmit="return confirm('Unblock these dates?');">
                                <button type="submit" class="btn btn-link text-danger p-0 ms-1" style="font-size: 0.75rem;" title="Unblock">
                                  <i class="fa-solid fa-xmark"></i>
                                </button>
                              </form>
                            </div>
                          <% }) %>
                        </div>
                      </div>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </section>

            <hr class="my-4" />

            <!-- Map Section -->
            <div class="mb-4">
              <h4 class="fw-bold mb-2"><%= t('booking.whereYoullBe') %></h4>
              <p class="text-muted small mb-3"><i class="fa-solid fa-location-dot text-primary me-1"></i>
                <%= listing.location %>, <%= listing.country %>
              </p>

              <!-- Interactive Mapbox Container -->
              <div id="map"></div>
            </div>

            <hr class="my-4" />

            <!-- Reviews Section -->
            <section class="reviews-section mt-4">
              <div class="d-flex align-items-center justify-content-between mb-4">
                <h4 class="fw-bold mb-0">
                  <i class="fa-solid fa-star text-warning me-1"></i>
                  <%= listing.averageRating ? listing.averageRating.toFixed(1) : 'New' %> • <%= listing.reviews ?
                      listing.reviews.length : 0 %> Reviews
                </h4>
              </div>

              <!-- Add Review Form (for logged in users) -->
              <% if (user) { %>
                <div class="glass-card rounded-4 p-4 mb-4">
                  <h5 class="fw-bold mb-3"><%= t('booking.leaveReview') %></h5>
                  <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
                    <div class="mb-3">
                      <label class="form-label"><%= t('booking.rating') %></label>
                      <fieldset class="starability-basic">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                          aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" checked />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                      </fieldset>
                    </div>

                    <div class="mb-3">
                      <label for="comment" class="form-label"><%= t('booking.yourExperience') %></label>
                      <textarea name="review[comment]" id="comment" rows="3" class="form-control rounded-3"
                        placeholder="Write what you loved about this stay..." required></textarea>
                      <div class="invalid-feedback">Please provide a review comment.</div>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill px-4"><%= t('booking.submitReview') %></button>
                  </form>
                </div>
                <% } else { %>
                  <div class="glass-card border rounded-4 p-3 mb-4">
                    <a href="/login" class="text-primary fw-bold">Log in</a> or <a href="/signup"
                      class="text-primary fw-bold">Sign up</a> to leave a review for this property.
                  </div>
                  <% } %>

                    <!-- Reviews Grid -->
                    <% if (listing.reviews && listing.reviews.length> 0) { %>
                      <div class="row g-3">
                        <% for(let review of listing.reviews) { %>
                          <div class="col-md-6">
                            <div class="review-card-item">
                              <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="review-card-author">
                                  <img
                                    src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=80&q=80"
                                    alt="User avatar" class="avatar-img" />
                                  <div>
                                    <div class="fw-bold">
                                      <%= review.author && review.author.username ? review.author.username : 'Traveler'
                                        %>
                                    </div>
                                    <div class="small text-muted">
                                      <%= review.createdAt ? new Date(review.createdAt).toLocaleDateString('en-US', {
                                        month: 'short' , year: 'numeric' }) : 'Recently' %>
                                    </div>
                                  </div>
                                </div>

                                <div class="review-stars">
                                  <% for(let s=1; s <=5; s++) { %>
                                    <i
                                      class="fa-solid fa-star <%= s <= review.rating ? 'text-warning' : 'text-muted text-opacity-25' %>"></i>
                                    <% } %>
                                </div>
                              </div>

                              <p class="text-secondary small mb-3 flex-grow-1">
                                <%= review.comment %>
                              </p>

                              <!-- Delete review if author -->
                              <% if (user && review.author && review.author._id && user._id &&
                                review.author._id.equals(user._id)) { %>
                                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                  method="POST">
                                  <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                    <i class="fa-solid fa-trash-can me-1"></i>Delete
                                  </button>
                                </form>
                                <% } %>
                            </div>
                          </div>
                          <% } %>
                      </div>
                      <% } else { %>
                        <div class="text-center py-4 px-3 bg-body-tertiary rounded-4 border">
                          <i class="fa-regular fa-comment-dots fs-3 text-muted mb-2"></i>
                          <div class="fw-semibold">Be the first to share your experience.</div>
                          <p class="text-muted small mb-0">Help other travelers by leaving an authentic review after your stay.</p>
                        </div>
                      <% } %>
            </section>

            <hr class="my-4" />

            <!-- Cancellation Policy Section -->
            <section class="cancellation-policy-section mb-4" id="cancellation-policy">
              <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
                <h4 class="fw-bold mb-0"><%= t('booking.cancellationPolicy') %></h4>
                <span class="badge <%= (cancellationPolicy && cancellationPolicy.badgeClass) || 'bg-success-subtle text-success border' %> px-3 py-2 rounded-pill fs-6 fw-semibold align-self-start align-self-sm-center">
                  <i class="<%= (cancellationPolicy && cancellationPolicy.icon) || 'fa-solid fa-feather-pointed' %> me-1"></i> <%= (cancellationPolicy && cancellationPolicy.name) || 'Flexible' %> Policy
                </span>
              </div>

              <div class="glass-card rounded-4 p-4 border mb-3">
                <div class="d-flex align-items-start gap-3 mb-3">
                  <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; background: rgba(255, 56, 92, 0.08); color: var(--primary); font-size: 1.3rem;">
                    <i class="<%= (cancellationPolicy && cancellationPolicy.icon) || 'fa-solid fa-feather-pointed' %>"></i>
                  </div>
                  <div>
                    <h5 class="fw-bold mb-1"><%= (cancellationPolicy && cancellationPolicy.headline) || 'Full refund 1 day prior to arrival' %></h5>
                    <p class="text-muted small mb-0"><%= (cancellationPolicy && cancellationPolicy.summary) || 'Free cancellation up to 24 hours prior to check-in.' %></p>
                  </div>
                </div>

                <div class="row g-2 pt-2 border-top">
                  <% ((cancellationPolicy && cancellationPolicy.rules) || []).forEach((rule, rIdx) => { %>
                    <div class="col-md-4">
                      <div class="p-3 rounded-3 bg-body-tertiary h-100 border border-theme">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <span class="small text-muted fw-semibold">Rule <%= rIdx + 1 %></span>
                          <span class="badge <%= rule.percentage === 100 ? 'bg-success text-white' : (rule.percentage === 50 ? 'bg-warning text-dark' : 'bg-secondary text-white') %> rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">
                            <%= rule.refundText %>
                          </span>
                        </div>
                        <div class="fw-bold small text-body mb-1"><%= rule.cutoff %></div>
                        <div class="text-muted" style="font-size: 0.76rem; line-height: 1.4;"><%= rule.description %></div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>

              <div class="small text-muted d-flex align-items-center gap-2">
                <i class="fa-solid fa-shield-check text-success fs-6"></i>
                <span>WanderStay guarantees secure, automated refunds directly through our payment provider based on this policy.</span>
              </div>
            </section>
          </div>

          <!-- Right Sticky Booking Column -->
          <div class="col-lg-5 col-xl-4">
            <div class="booking-widget-card">
              <div class="d-flex justify-content-between align-items-baseline mb-3">
                <div>
                  <% const widgetPrice = (typeof getPriceDisplay === 'function') ? getPriceDisplay(listing.price) : { formattedTarget: `₹${Number(listing.price).toLocaleString('en-IN')}`, isConverted: false, formattedBase: `₹${Number(listing.price).toLocaleString('en-IN')}` }; %>
                  <span class="booking-widget-price"><%= widgetPrice.formattedTarget %></span>
                  <span class="text-muted"> / <%= t('booking.night') %></span>
                  <% if (widgetPrice.isConverted) { %>
                    <div class="text-muted mt-0.5" style="font-size: 0.72rem;">
                      <i class="fa-solid fa-shield-halved text-success me-1"></i>Base: <strong><%= widgetPrice.formattedBase %></strong>
                    </div>
                  <% } %>
                  <% 
                    const hasDynamic = listing.pricing && (
                      listing.pricing.weekendPrice ||
                      (listing.pricing.seasonalPricing && listing.pricing.seasonalPricing.length > 0) ||
                      (listing.pricing.holidayPricing && listing.pricing.holidayPricing.length > 0) ||
                      (listing.pricing.extraGuestFee > 0)
                    );
                  %>
                  <% if (hasDynamic) { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0.5 ms-1" style="font-size: 0.72rem;" title="Weekend, seasonal, or holiday rates configured by host">
                      <i class="fa-solid fa-chart-line me-1"></i><%= t('booking.dynamicRates') %>
                    </span>
                  <% } %>
                </div>
                <div class="small fw-bold">
                  <i class="fa-solid fa-star text-warning"></i>
                  <span>
                    <%= listing.averageRating ? listing.averageRating.toFixed(1) : 'New' %>
                  </span>
                </div>
              </div>

              <% if (hasDynamic) { %>
                <!-- Host Dynamic Rates Disclosure -->
                <div class="p-2.5 bg-body-tertiary rounded-3 border border-theme mb-3 small" style="font-size: 0.78rem;">
                  <div class="fw-semibold text-body mb-1 d-flex align-items-center gap-1">
                    <i class="fa-solid fa-tags text-primary"></i>
                    <span><%= t('booking.configuredHostRates') %></span>
                  </div>
                  <div class="text-muted d-flex flex-column gap-0.5">
                    <div>• <%= t('booking.weekdayBase') %>: <strong>₹<%= Number(listing.price).toLocaleString("en-IN") %>/<%= t('booking.night') %></strong></div>
                    <% if (listing.pricing.weekendPrice) { %>
                      <div>• <%= t('booking.weekendRate') %>: <strong>₹<%= Number(listing.pricing.weekendPrice).toLocaleString("en-IN") %>/<%= t('booking.night') %></strong></div>
                    <% } %>
                    <% if (listing.pricing.extraGuestFee > 0) { %>
                      <div>• <%= t('booking.extraGuests') %>: <strong>₹<%= Number(listing.pricing.extraGuestFee).toLocaleString("en-IN") %>/guest/<%= t('booking.night') %></strong> (after <%= listing.pricing.baseGuests || 2 %> included)</div>
                    <% } %>
                    <% if (listing.pricing.holidayPricing && listing.pricing.holidayPricing.length > 0) { %>
                      <div>• <%= t('booking.holidayRates') %>: <strong><%= listing.pricing.holidayPricing.length %> special period<%= listing.pricing.holidayPricing.length > 1 ? 's' : '' %></strong></div>
                    <% } %>
                    <% if (listing.pricing.seasonalPricing && listing.pricing.seasonalPricing.length > 0) { %>
                      <div>• <%= t('booking.seasonalRates') %>: <strong><%= listing.pricing.seasonalPricing.length %> seasonal period<%= listing.pricing.seasonalPricing.length > 1 ? 's' : '' %></strong></div>
                    <% } %>
                  </div>
                </div>
              <% } %>

              <!-- Booking Form -->
              <form action="/listings/<%= listing._id %>/bookings" method="POST" class="needs-validation" novalidate
                id="booking-form">
                <div class="booking-inputs-box">
                  <div class="p-2 border-bottom">
                    <label for="checkInDate" class="search-field-label"><%= t('search.checkIn').toUpperCase() %></label>
                    <input type="date" id="checkInDate" name="booking[checkIn]" class="form-control" required />
                  </div>
                  <div class="p-2 border-bottom">
                    <label for="checkOutDate" class="search-field-label"><%= t('search.checkOut').toUpperCase() %></label>
                    <input type="date" id="checkOutDate" name="booking[checkOut]" class="form-control" required />
                  </div>
                  <div class="p-2">
                    <label for="bookingGuests" class="search-field-label"><%= t('search.guests').toUpperCase() %></label>
                    <select id="bookingGuests" name="booking[guests]" class="form-select border-0 p-0">
                      <option value="1">1 <%= t('search.guest') %></option>
                      <option value="2">2 <%= t('search.guests') %></option>
                      <option value="3">3 <%= t('search.guests') %></option>
                      <option value="4">4+ <%= t('search.guests') %></option>
                    </select>
                  </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 mb-2">
                  <i class="fa-solid fa-bolt me-1"></i> <%= t('booking.reserveNow') %>
                </button>
                <a href="#calendar-section" class="d-block text-center small text-muted text-decoration-none mb-3">
                  <i class="fa-regular fa-calendar-check text-primary me-1"></i> <%= t('booking.viewCalendar') %>
                </a>
              </form>

              <!-- Price Breakdown Calculator -->
              <div class="booking-breakdown" id="price-breakdown">
                <div class="text-center text-muted small mb-2"><%= t('booking.youWontBeChargedYet') %></div>
                <div class="booking-breakdown-row">
                  <span>&#8377; <%= Number(listing.price).toLocaleString("en-IN") %> &times; <span
                        id="calc-nights">1</span> <%= t('booking.night') %></span>
                  <span id="calc-base-price">&#8377; <%= Number(listing.price).toLocaleString("en-IN") %></span>
                </div>
                <div class="booking-breakdown-row">
                  <span><%= t('booking.cleaningFee') %></span>
                  <span>&#8377; 500</span>
                </div>
                <div class="booking-breakdown-row">
                  <span><%= t('booking.serviceFee') %></span>
                  <span>&#8377; 750</span>
                </div>
                <div class="booking-breakdown-total">
                  <span><%= t('booking.totalBeforeTaxes') %></span>
                  <span id="calc-total-price">&#8377; <%= (Number(listing.price) + 1250).toLocaleString("en-IN") %>
                      </span>
                </div>
              </div>

              <% if (typeof currentCurrency !== 'undefined' && currentCurrency !== 'INR') { %>
                <div class="p-2.5 mt-2 bg-body-tertiary rounded-3 border border-theme small" style="font-size: 0.74rem;">
                  <div class="fw-semibold text-body mb-0.5 d-flex align-items-center gap-1">
                    <i class="fa-solid fa-coins text-success"></i>
                    <span><%= t('currency.currency') %>: <%= currentCurrency %> (<%= (typeof currentCurrencyConfig !== 'undefined' && currentCurrencyConfig.symbol) ? currentCurrencyConfig.symbol : '' %>)</span>
                  </div>
                  <div class="text-muted">
                    <%= t('currency.chargedInINR') %> Displayed rates are converted at indicative exchange rates.
                  </div>
                </div>
              <% } %>

              <!-- Cancellation policy note in widget -->
              <div class="mt-3 pt-3 border-top small">
                <div class="d-flex align-items-center justify-content-between mb-1">
                  <span class="text-muted fw-semibold"><i class="fa-solid fa-clock-rotate-left text-primary me-1"></i> <%= t('booking.cancellationPolicy') %>:</span>
                  <span class="badge <%= (cancellationPolicy && cancellationPolicy.badgeClass) || 'bg-success-subtle text-success' %> rounded-pill px-2 py-0.5"><%= (cancellationPolicy && cancellationPolicy.name) || 'Flexible' %></span>
                </div>
                <div class="text-muted" style="font-size: 0.76rem; line-height: 1.4;">
                  <%= (cancellationPolicy && cancellationPolicy.summary) || 'Free cancellation available.' %>
                  <a href="#cancellation-policy" class="text-primary text-decoration-none ms-1 fw-semibold">Details</a>
                </div>
              </div>

              <!-- Host Action Controls (if owner) -->
              <% if (user && listing.owner && listing.owner._id && user._id && listing.owner._id.equals(user._id)) { %>
                <div class="mt-4 pt-3 border-top">
                  <div class="small fw-bold text-muted mb-2">Host Settings</div>
                  <div class="d-flex gap-2">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-secondary flex-grow-1 rounded-pill">
                      <i class="fa-solid fa-pen-to-square me-1"></i><%= t('buttons.edit') %>
                    </a>
                    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="flex-grow-1"
                      onsubmit="return confirm('Are you sure you want to delete this listing?');">
                      <button type="submit" class="btn btn-outline-danger w-100 rounded-pill">
                        <i class="fa-solid fa-trash-can me-1"></i><%= t('buttons.delete') %>
                      </button>
                    </form>
                  </div>
                </div>
                <% } %>
            </div>
          </div>
        </div>

        <!-- Similar Properties Section (Real database recommendations) -->
        <% if (typeof similarListings !== 'undefined' && similarListings.length > 0) { %>
          <div class="similar-listings-section mt-5 pt-5 border-top reveal-on-scroll">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-2 mb-4">
              <div>
                <div class="section-kicker">EXPLORE MORE</div>
                <h3 class="fw-bold mb-1">Similar Stays You Might Like</h3>
                <p class="text-muted small mb-0">Handpicked retreats in <%= listing.country %> and <%= listing.category %> categories.</p>
              </div>
              <a href="/listings?category=<%= encodeURIComponent(listing.category) %>" class="btn btn-outline-secondary rounded-pill btn-sm px-3 align-self-start align-self-sm-auto">
                Explore all <%= listing.category %> stays &rarr;
              </a>
            </div>

            <div class="row g-4">
              <% similarListings.forEach(sim => { %>
                <div class="col-md-4">
                  <div class="listing-card-wrapper h-100">
                    <div class="listing-card-media">
                      <a href="/listings/<%= sim._id %>" aria-label="View <%= sim.title %>">
                        <img 
                          src="<%= (sim.image && sim.image.url) ? sim.image.url : (sim.photos && sim.photos[0] && (sim.photos[0].url || sim.photos[0])) || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80' %>" 
                          alt="<%= sim.title %>"
                          loading="lazy"
                          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80';"
                        />
                      </a>
                      <span class="listing-category-badge"><%= sim.category %></span>
                    </div>

                    <a href="/listings/<%= sim._id %>" class="text-decoration-none text-reset listing-card-body d-flex flex-column">
                      <div class="listing-card-header">
                        <div class="listing-card-location"><i class="fa-solid fa-location-dot text-primary me-1"></i><%= sim.location %>, <%= sim.country %></div>
                        <div class="listing-rating-badge">
                          <i class="fa-solid fa-star"></i>
                          <span><%= sim.averageRating ? sim.averageRating.toFixed(1) : '4.9' %></span>
                        </div>
                      </div>
                      <div class="listing-card-title text-truncate"><%= sim.title %></div>
                      <div class="small text-muted mb-2"><%= sim.guests || 2 %> guests • <%= sim.bedrooms || 1 %> bed<%= (sim.bedrooms || 1) > 1 ? 's' : '' %></div>
                      
                      <div class="listing-card-footer mt-auto pt-2">
                        <div>
                          <% const simPrice = (typeof getPriceDisplay === 'function') ? getPriceDisplay(sim.price) : { formattedTarget: `₹${Number(sim.price).toLocaleString('en-IN')}`, isConverted: false, formattedBase: `₹${Number(sim.price).toLocaleString('en-IN')}` }; %>
                          <span class="listing-price-tag"><%= simPrice.formattedTarget %></span>
                          <span class="listing-price-period">/ night</span>
                        </div>
                        <span class="text-primary small fw-semibold">View stay &rarr;</span>
                      </div>
                    </a>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Mobile Bottom Sticky Booking Bar (Visible on mobile/tablet screens only) -->
        <div class="mobile-booking-bar d-lg-none" id="mobileBookingBar">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="d-flex align-items-baseline gap-1">
                <span class="fw-bold fs-5 text-body"><%= widgetPrice.formattedTarget %></span>
                <span class="text-muted small">/ <%= t('booking.night') %></span>
              </div>
              <div class="small text-muted" style="font-size: 0.75rem;">
                <i class="fa-solid fa-star text-warning me-0.5"></i>
                <strong class="text-body"><%= listing.averageRating ? listing.averageRating.toFixed(1) : 'New' %></strong>
                <% if (widgetPrice.isConverted) { %>
                  <span>• (~<%= widgetPrice.formattedBase %>)</span>
                <% } %>
              </div>
            </div>
            <a href="#booking-form" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="document.getElementById('checkInDate') && document.getElementById('checkInDate').focus();">
              <i class="fa-solid fa-bolt me-1"></i> Check dates
            </a>
          </div>
        </div>

        <!-- Map & Listing Data Scripts -->
        <script>
          window.mapToken = "<%= mapToken %>";
          window.listing = {
            title: <%- JSON.stringify(listing.title) %>,
            location: <%- JSON.stringify(listing.location) %>,
            geometry: <%- JSON.stringify(listing.geometry || { type: 'Point', coordinates: [77.2090, 28.6139] }) %>
          };

          window.availabilityData = {
            bookedRanges: <%- JSON.stringify((confirmedBookings || []).map(b => ({ checkIn: b.checkIn, checkOut: b.checkOut, nights: b.nights }))) %>,
            blockedRanges: <%- JSON.stringify((blockedDates || []).map(b => ({ _id: b._id, startDate: b.startDate, endDate: b.endDate, reason: b.reason }))) %>
          };

          // Real-time secure booking price calculation
          (function () {
            const checkInInput = document.getElementById('checkInDate');
            const checkOutInput = document.getElementById('checkOutDate');
            const guestsInput = document.getElementById('bookingGuests');
            const pricePerNight = <%= Number(listing.price) %>;
            const listingId = "<%= listing._id %>";
            const breakdownContainer = document.getElementById('price-breakdown');

            async function updatePrice() {
              if (!checkInInput || !checkOutInput || !checkInInput.value || !checkOutInput.value) return;
              const d1 = new Date(checkInInput.value);
              const d2 = new Date(checkOutInput.value);
              if (d2 <= d1) return;

              const nights = Math.max(1, Math.round((d2 - d1) / (1000 * 60 * 60 * 24)));
              const guests = guestsInput ? guestsInput.value : 1;

              try {
                const res = await fetch(`/listings/${listingId}/pricing/quote?checkIn=${encodeURIComponent(checkInInput.value)}&checkOut=${encodeURIComponent(checkOutInput.value)}&guests=${encodeURIComponent(guests)}`);
                const data = await res.json();

                if (data.success && data.pricing) {
                  renderBreakdown(data.pricing);
                } else {
                  renderFallback(nights);
                }
              } catch (err) {
                renderFallback(nights);
              }
            }

            const currRate = <%= (typeof getExchangeRate === 'function' && typeof currentCurrency !== 'undefined') ? getExchangeRate(currentCurrency) : 1 %>;
            const currCode = "<%= typeof currentCurrency !== 'undefined' ? currentCurrency : 'INR' %>";
            const currSymbol = "<%= (typeof currentCurrencyConfig !== 'undefined' && currentCurrencyConfig.symbol) ? currentCurrencyConfig.symbol : '₹' %>";

            function formatPrice(amt) {
              if (currCode === 'INR') {
                return '₹ ' + Math.round(amt).toLocaleString('en-IN');
              }
              const converted = Math.round(amt * currRate);
              return `${currSymbol}${converted.toLocaleString('en-US')} <small class="text-muted fw-normal" style="font-size:0.75rem;">(~₹${Math.round(amt).toLocaleString('en-IN')})</small>`;
            }

            function formatTotal(amt) {
              if (currCode === 'INR') {
                return '₹ ' + Math.round(amt).toLocaleString('en-IN');
              }
              const converted = Math.round(amt * currRate);
              return `${currSymbol}${converted.toLocaleString('en-US')} <small class="text-muted fw-normal" style="font-size:0.8rem;">(~₹${Math.round(amt).toLocaleString('en-IN')} INR)</small>`;
            }

            function renderBreakdown(p) {
              if (!breakdownContainer) return;
              let rowsHtml = '<div class="text-center text-muted small mb-2">You won\'t be charged yet</div>';

              if (p.isDynamicPricingActive) {
                if (p.weekdayNights > 0) {
                  rowsHtml += `
                    <div class="booking-breakdown-row">
                      <span>${formatPrice(p.weekdayRate)} &times; ${p.weekdayNights} weekday ${p.weekdayNights === 1 ? 'night' : 'nights'}</span>
                      <span>${formatPrice(p.weekdayTotal)}</span>
                    </div>`;
                }
                if (p.weekendNights > 0) {
                  rowsHtml += `
                    <div class="booking-breakdown-row text-warning-emphasis">
                      <span><i class="fa-solid fa-champagne-glasses me-1"></i>${formatPrice(p.weekendRate)} &times; ${p.weekendNights} weekend ${p.weekendNights === 1 ? 'night' : 'nights'}</span>
                      <span>${formatPrice(p.weekendTotal)}</span>
                    </div>`;
                }
                if (p.seasonalNights > 0) {
                  rowsHtml += `
                    <div class="booking-breakdown-row text-primary">
                      <span><i class="fa-solid fa-cloud-sun me-1"></i>${p.seasonalName || 'Seasonal'}: ${formatPrice(p.seasonalRate)} &times; ${p.seasonalNights} ${p.seasonalNights === 1 ? 'night' : 'nights'}</span>
                      <span>${formatPrice(p.seasonalTotal)}</span>
                    </div>`;
                }
                if (p.holidayNights > 0) {
                  rowsHtml += `
                    <div class="booking-breakdown-row text-danger">
                      <span><i class="fa-solid fa-holly-berry me-1"></i>${p.holidayName || 'Holiday'}: ${formatPrice(p.holidayRate)} &times; ${p.holidayNights} ${p.holidayNights === 1 ? 'night' : 'nights'}</span>
                      <span>${formatPrice(p.holidayTotal)}</span>
                    </div>`;
                }
                if (p.extraGuestTotal > 0) {
                  rowsHtml += `
                    <div class="booking-breakdown-row text-success">
                      <span><i class="fa-solid fa-user-plus me-1"></i>${p.extraGuests} extra ${p.extraGuests === 1 ? 'guest' : 'guests'} &times; ${p.nights} nts (@₹${p.extraGuestFeePerNight}/nt)</span>
                      <span>${formatPrice(p.extraGuestTotal)}</span>
                    </div>`;
                }
              } else {
                rowsHtml += `
                  <div class="booking-breakdown-row">
                    <span>${formatPrice(pricePerNight)} &times; ${p.nights} ${p.nights === 1 ? 'night' : 'nights'}</span>
                    <span>${formatPrice(p.roomSubtotal)}</span>
                  </div>`;
              }

              rowsHtml += `
                <div class="booking-breakdown-row">
                  <span>Cleaning fee</span>
                  <span>${formatPrice(p.cleaningFee)}</span>
                </div>
                <div class="booking-breakdown-row">
                  <span>WanderStay service fee</span>
                  <span>${formatPrice(p.serviceFee)}</span>
                </div>
                <div class="booking-breakdown-total">
                  <span>Total before taxes</span>
                  <span class="text-primary fw-bold">${formatTotal(p.totalPrice)}</span>
                </div>
              `;

              breakdownContainer.innerHTML = rowsHtml;
            }

            function renderFallback(nights) {
              if (!breakdownContainer) return;
              const base = nights * pricePerNight;
              const total = base + 1250;
              breakdownContainer.innerHTML = `
                <div class="text-center text-muted small mb-2">You won't be charged yet</div>
                <div class="booking-breakdown-row">
                  <span>${formatPrice(pricePerNight)} &times; ${nights} ${nights === 1 ? 'night' : 'nights'}</span>
                  <span>${formatPrice(base)}</span>
                </div>
                <div class="booking-breakdown-row">
                  <span>Cleaning fee</span>
                  <span>${formatPrice(500)}</span>
                </div>
                <div class="booking-breakdown-row">
                  <span>WanderStay service fee</span>
                  <span>${formatPrice(750)}</span>
                </div>
                <div class="booking-breakdown-total">
                  <span>Total before taxes</span>
                  <span class="text-primary fw-bold">${formatTotal(total)}</span>
                </div>
              `;
            }

            window.wanderUpdatePrice = updatePrice;

            if (checkInInput) checkInInput.addEventListener('change', updatePrice);
            if (checkOutInput) checkOutInput.addEventListener('change', updatePrice);
            if (guestsInput) guestsInput.addEventListener('change', updatePrice);
            updatePrice();
          })();
        </script>
    </div>

    <!-- Full-Screen Cinematic Lightbox Modal -->
    <div id="cinematicLightbox" class="cinematic-lightbox d-none" role="dialog" aria-modal="true" aria-label="Image gallery lightbox">
      <div class="lightbox-header">
        <div class="d-flex align-items-center gap-3">
          <span class="lightbox-counter">
            <span id="lbCurrentIndex">1</span> / <span id="lbTotalCount"><%= photosList.length %></span>
          </span>
          <span class="lightbox-title d-none d-sm-inline-block text-truncate"><%= listing.title %></span>
        </div>
        <button type="button" class="lightbox-btn-close" id="lbCloseBtn" aria-label="Close full-screen gallery">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Main Lightbox Stage -->
      <div class="lightbox-stage">
        <button type="button" class="lightbox-nav-arrow lb-prev" id="lbPrevBtn" aria-label="Previous image">
          <i class="fa-solid fa-chevron-left"></i>
        </button>

        <div class="lightbox-media-wrapper" id="lbMediaWrapper">
          <div id="lbSpinner" class="lightbox-spinner d-none">
            <div class="spinner-border text-light" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
          </div>
          <img 
            id="lbMainImage" 
            src="<%= mainPhoto.full %>" 
            alt="<%= listing.title %> full size" 
            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1920&q=90';"
          />
        </div>

        <button type="button" class="lightbox-nav-arrow lb-next" id="lbNextBtn" aria-label="Next image">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>

      <!-- Bottom Lightbox Thumbnail Tray -->
      <div class="lightbox-tray-container">
        <div class="lightbox-tray" id="lbThumbTray">
          <% photosList.forEach((p, idx) => { %>
            <button 
              type="button" 
              class="lb-tray-thumb <%= idx === 0 ? 'active' : '' %>" 
              data-index="<%= idx %>"
              aria-label="Jump to photo <%= idx + 1 %>"
            >
              <img 
                src="<%= p.thumb %>" 
                alt="Thumbnail <%= idx + 1 %>" 
                loading="lazy"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=360&q=75';"
              />
            </button>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Gallery Photos JSON Data for Client-Side Engine -->
    <script type="application/json" id="listingGalleryData">
      <%- JSON.stringify(photosList) %>
    </script>

    <script src="/js/gallery.js"></script>
    <script src="/js/calendar.js"></script>
    <script src="/js/map.js"></script>









