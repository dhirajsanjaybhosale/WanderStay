<%layout("/layouts/boilerplate.ejs")%> 
    <div id="filters">
      <a class="filter <%= !currentCategory ? 'active' : '' %>" href="/listings">
         <i class="fa-solid fa-border-all"></i> All
      </a>
      <a class="filter <%= currentCategory==='Villa' ? 'active' : '' %>" href="/listings?category=Villa">
          <i class="fa-solid fa-crown"></i> Villa
      </a>
       <a class="filter <%= currentCategory==='Desert' ? 'active' : '' %>" href="/listings?category=Desert">
          <i class="fa-solid fa-sun"></i> Desert
       </a>
       <a class="filter <%= currentCategory==='Cabin' ? 'active' : '' %>" href="/listings?category=Cabin">
          <i class="fa-solid fa-house-chimney"></i> Cabin
       </a>
       <a class="filter <%= currentCategory==='Lake' ? 'active' : '' %>" href="/listings?category=Lake">
          <i class="fa-solid fa-water"></i> Lake
       </a>
       <a class="filter <%= currentCategory==='Ski' ? 'active' : '' %>" href="/listings?category=Ski">
           <i class="fa-solid fa-person-skiing"></i> Ski
       </a>
        <a class="filter <%= currentCategory==='Beach' ? 'active' : '' %>" href="/listings?category=Beach">
          <i class="fa-solid fa-umbrella-beach"></i> Beach
        </a>
        <a class="filter <%= currentCategory==='City' ? 'active' : '' %>" href="/listings?category=City">
             <i class="fa-solid fa-city"></i> City
       </a>
       <a class="filter <%= currentCategory==='Mountain' ? 'active' : '' %>" href="/listings?category=Mountain">
            <i class="fa-solid fa-mountain"></i> Mountain
       </a>
      

      <div class="tax-toggle" >
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after taxes </label>
        </div>
      </div>
    </div>

<div id="listing-index">
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3 g-4">
    <% for(let listing of allListings) { %>
      <div class="col">
        <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none">
          <div class="card listing-card h-100 shadow-sm">
            <div class="ratio ratio-4x3">
              <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image">
            </div>
            <div class="card-body">
              <p class="card-text mb-1">
                <b><%= listing.title %></b>
              </p>
              <p class="card-text text-muted mb-0">
                &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
                <i class="tax-info">&nbsp; &nbsp;+18% GST</i>
              </p>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>
</div>
  



<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click",() => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for(let info of taxInfo) {
      if(info.style.display != "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }

    }
  });
</script>




















<style>
  /* ================= FILTER BAR ================= */
#filters {
  display: flex;
  align-items: center;
  gap: 18px;
  overflow-x: auto;
  padding: 12px 5px;
  margin-bottom: 10px;
  scrollbar-width: none;
}

#filters::-webkit-scrollbar {
  display: none;
}

.filter {
  text-align: center;
  color: #555;
  font-size: 14px;
  padding: 8px 12px;
  border-radius: 12px;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.filter i {
  display: block;
  font-size: 18px;
  margin-bottom: 4px;
}

.filter:hover {
  background-color: #f2f2f2;
}

.filter.active {
  color: #000;
  border-bottom: 2px solid #000;
}

/* Tax toggle */
.tax-toggle {
  margin-left: auto;
  white-space: nowrap;
}

/* ================= LISTING CARDS ================= */
.listing-card img {
  object-fit: cover;
  border-radius: 12px 12px 0 0;
}

.listing-card {
  border-radius: 12px;
  transition: transform 0.2s ease;
}

.listing-card:hover {
  transform: scale(1.02);
}

/* ================= TABLET (≤ 992px) ================= */
@media (max-width: 992px) {
  #filters {
    gap: 14px;
    padding: 10px 5px;
  }

  .filter {
    font-size: 13px;
  }

  .filter i {
    font-size: 16px;
  }

  .tax-toggle label {
    font-size: 13px;
  }
}

/* ================= MOBILE (≤ 768px) ================= */
@media (max-width: 768px) {
  #filters {
    padding: 8px 5px;
  }

  .filter {
    font-size: 12px;
    padding: 6px 10px;
  }

  .filter i {
    font-size: 15px;
  }

  .tax-toggle {
    display: none; /* Hide tax toggle on small screens */
  }

  .card-text b {
    font-size: 14px;
  }

  .card-text {
    font-size: 13px;
  }
}

/* ================= SMALL PHONES (≤ 480px) ================= */
@media (max-width: 480px) {
  .filter {
    font-size: 11px;
  }

  .filter i {
    font-size: 14px;
  }

  .listing-card {
    border-radius: 10px;
  }
}

</style>