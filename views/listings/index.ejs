<% layout("/layouts/boilerplate.ejs") %>

<%
  // Helper to build URLs preserving other query params while updating or removing specific keys
  function getFilterUrl(overrides = {}, removes = []) {
    const p = new URLSearchParams();
    const currentQ = (typeof query !== 'undefined' && query) ? query : {};
    
    for (const [key, val] of Object.entries(currentQ)) {
      if (removes.includes(key)) continue;
      if (key === 'page') continue; // Always reset page when changing filters
      if (Array.isArray(val)) {
        val.forEach(item => {
          if (!removes.includes(`${key}:${item}`)) p.append(key, item);
        });
      } else if (val !== undefined && val !== null && val !== '') {
        p.set(key, val);
      }
    }

    for (const [key, val] of Object.entries(overrides)) {
      if (val === null || val === undefined || val === '') {
        p.delete(key);
      } else {
        p.set(key, val);
      }
    }

    const qs = p.toString();
    return qs ? `/listings?${qs}` : '/listings';
  }

  const activeAms = (typeof selectedAmenities !== 'undefined' && Array.isArray(selectedAmenities)) ? selectedAmenities : [];
  const totalCount = typeof totalListings !== 'undefined' ? totalListings : allListings.length;
  const currPage = typeof currentPage !== 'undefined' ? currentPage : 1;
  const totPages = typeof totalPages !== 'undefined' ? totalPages : 1;
%>

<div class="container-max py-4">
  <!-- Top Category Filter Bar -->
  <section class="category-scroll-wrapper mt-1 mb-3 reveal-on-scroll">
    <div class="category-chips-bar">
      <a href="<%= getFilterUrl({}, ['category']) %>" class="category-chip-item <%= !currentCategory ? 'active' : '' %> text-decoration-none">
        <i class="fa-solid fa-compass"></i>
        <span><%= t('filters.allStays') %></span>
      </a>
      <% (categories || []).forEach(cat => { %>
        <% 
          let iconClass = 'fa-solid fa-house';
          if (cat === 'Beach') iconClass = 'fa-solid fa-umbrella-beach';
          else if (cat === 'Mountain') iconClass = 'fa-solid fa-mountain';
          else if (cat === 'Cabin') iconClass = 'fa-solid fa-campground';
          else if (cat === 'City') iconClass = 'fa-solid fa-city';
          else if (cat === 'Villa') iconClass = 'fa-solid fa-house-chimney-window';
          else if (cat === 'Lake') iconClass = 'fa-solid fa-water';
          else if (cat === 'Ski') iconClass = 'fa-solid fa-person-skiing';
          else if (cat === 'Desert') iconClass = 'fa-solid fa-sun';
        %>
        <a href="<%= getFilterUrl({ category: cat }) %>" class="category-chip-item <%= currentCategory === cat ? 'active' : '' %> text-decoration-none">
          <i class="<%= iconClass %>"></i>
          <span><%= cat %></span>
        </a>
      <% }) %>
    </div>
  </section>

  <!-- Filter & Summary Control Bar -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3 p-3 glass-panel listings-summary-bar reveal-on-scroll">
    <div class="d-flex align-items-center gap-3 flex-wrap">
      <!-- Mobile Filter Trigger Button (opens bottom sheet drawer) -->
      <button 
        type="button" 
        class="btn btn-outline-dark btn-sm rounded-pill d-lg-none d-inline-flex align-items-center gap-2 fw-semibold px-3 py-2"
        data-bs-toggle="offcanvas" 
        data-bs-target="#mobileFilterDrawer" 
        aria-controls="mobileFilterDrawer"
      >
        <i class="fa-solid fa-sliders text-primary"></i>
        <span><%= t('filters.filters') %></span>
        <% if (activeFilterCount > 0) { %>
          <span class="badge bg-primary rounded-pill"><%= activeFilterCount %></span>
        <% } %>
      </button>

      <!-- Desktop Sidebar Toggle Button -->
      <button 
        type="button" 
        class="btn btn-sm btn-outline-secondary rounded-pill d-none d-lg-inline-flex align-items-center gap-1.5 fw-semibold px-3"
        id="toggleDesktopSidebarBtn"
      >
        <i class="fa-solid fa-sliders text-primary me-1"></i>
        <span><%= t('filters.filters') %></span>
        <% if (activeFilterCount > 0) { %>
          <span class="badge bg-primary text-white rounded-pill ms-1"><%= activeFilterCount %></span>
        <% } %>
      </button>

      <!-- Results Count & Search Context -->
      <div class="small">
        <span class="fw-bold fs-6"><%= totalCount %></span> 
        <span class="text-muted"><%= totalCount === 1 ? 'place' : 'places' %> to stay</span>
        <% if (searchQuery) { %>
          <span class="text-muted ms-1">in <strong class="text-primary">"<%= searchQuery %>"</strong></span>
        <% } %>
        <% if (currentCategory) { %>
          <span class="text-muted ms-1">&middot; <span class="badge bg-body-secondary text-body rounded-pill"><%= currentCategory %></span></span>
        <% } %>
      </div>
    </div>

    <!-- Right Controls: Sort Dropdown & Search Bar -->
    <div class="d-flex flex-wrap align-items-center gap-2">
      <!-- Sort Controls Form -->
      <form action="/listings" method="GET" class="d-flex align-items-center gap-2 m-0" id="sortForm">
        <% for(const [k, v] of Object.entries(query || {})) { %>
          <% if (k !== 'sortBy' && k !== 'page') { %>
            <% if (Array.isArray(v)) { %>
              <% v.forEach(item => { %><input type="hidden" name="<%= k %>" value="<%= item %>"><% }) %>
            <% } else if (v) { %>
              <input type="hidden" name="<%= k %>" value="<%= v %>">
            <% } %>
          <% } %>
        <% } %>
        
        <label for="sortBySelect" class="small text-muted text-nowrap fw-bold mb-0"><%= t('filters.sortBy') %>:</label>
        <select name="sortBy" id="sortBySelect" class="form-select form-select-sm rounded-pill" onchange="this.form.submit()">
          <option value="recommended" <%= sortBy === 'recommended' || !sortBy ? 'selected' : '' %>><%= t('filters.recommended') %></option>
          <option value="priceAsc" <%= sortBy === 'priceAsc' ? 'selected' : '' %>><%= t('filters.priceLowHigh') %></option>
          <option value="priceDesc" <%= sortBy === 'priceDesc' ? 'selected' : '' %>><%= t('filters.priceHighLow') %></option>
          <option value="rating" <%= sortBy === 'rating' ? 'selected' : '' %>><%= t('filters.rating') %></option>
          <option value="newest" <%= sortBy === 'newest' ? 'selected' : '' %>><%= t('filters.newest') %></option>
        </select>
      </form>
    </div>
  </div>

  <!-- Active Filter Tags Bar (Dismissible Tags) -->
  <% if (activeFilterCount > 0) { %>
    <div class="active-filters-bar reveal-on-scroll">
      <span class="small text-muted fw-bold me-2"><i class="fa-solid fa-filter me-1"></i>Active filters:</span>

      <% if (searchQuery) { %>
        <a href="<%= getFilterUrl({}, ['q', 'destination']) %>" class="active-filter-chip-tag" title="Remove destination filter">
          <span>Destination: <strong><%= searchQuery %></strong></span>
          <span class="chip-remove">&times;</span>
        </a>
      <% } %>

      <% if (currentCategory) { %>
        <a href="<%= getFilterUrl({}, ['category']) %>" class="active-filter-chip-tag" title="Remove category filter">
          <span>Category: <strong><%= currentCategory %></strong></span>
          <span class="chip-remove">&times;</span>
        </a>
      <% } %>

      <% if (minPrice || maxPrice) { %>
        <a href="<%= getFilterUrl({}, ['minPrice', 'maxPrice']) %>" class="active-filter-chip-tag" title="Remove price filter">
          <span>Price: <strong>&#8377;<%= minPrice || dbMinPrice %> - &#8377;<%= maxPrice || dbMaxPrice %></strong></span>
          <span class="chip-remove">&times;</span>
        </a>
      <% } %>

      <% if (minRating) { %>
        <a href="<%= getFilterUrl({}, ['minRating']) %>" class="active-filter-chip-tag" title="Remove rating filter">
          <span>Rating: <strong><%= minRating %>+ <i class="fa-solid fa-star small"></i></strong></span>
          <span class="chip-remove">&times;</span>
        </a>
      <% } %>

      <% if (guests && Number(guests) > 0) { %>
        <a href="<%= getFilterUrl({}, ['guests']) %>" class="active-filter-chip-tag" title="Remove guests filter">
          <span>Guests: <strong><%= guests %>+</strong></span>
          <span class="chip-remove">&times;</span>
        </a>
      <% } %>

      <% if (bedrooms && Number(bedrooms) > 0) { %>
        <a href="<%= getFilterUrl({}, ['bedrooms']) %>" class="active-filter-chip-tag" title="Remove bedrooms filter">
          <span>Bedrooms: <strong><%= bedrooms %>+</strong></span>
          <span class="chip-remove">&times;</span>
        </a>
      <% } %>

      <% if (bathrooms && Number(bathrooms) > 0) { %>
        <a href="<%= getFilterUrl({}, ['bathrooms']) %>" class="active-filter-chip-tag" title="Remove bathrooms filter">
          <span>Bathrooms: <strong><%= bathrooms %>+</strong></span>
          <span class="chip-remove">&times;</span>
        </a>
      <% } %>

      <% if (propertyType) { %>
        <a href="<%= getFilterUrl({}, ['propertyType']) %>" class="active-filter-chip-tag" title="Remove property type filter">
          <span>Type: <strong><%= propertyType %></strong></span>
          <span class="chip-remove">&times;</span>
        </a>
      <% } %>

      <% if (hostVerification === 'verified') { %>
        <a href="<%= getFilterUrl({}, ['hostVerification']) %>" class="active-filter-chip-tag text-success" title="Remove verified host filter">
          <i class="fa-solid fa-circle-check"></i>
          <span>Verified Hosts</span>
          <span class="chip-remove">&times;</span>
        </a>
      <% } %>

      <% if (instantBook === 'true') { %>
        <a href="<%= getFilterUrl({}, ['instantBook']) %>" class="active-filter-chip-tag text-warning" title="Remove instant book filter">
          <i class="fa-solid fa-bolt"></i>
          <span>Instant Book</span>
          <span class="chip-remove">&times;</span>
        </a>
      <% } %>

      <% activeAms.forEach(am => { %>
        <a href="<%= getFilterUrl({}, [`amenities:${am}`]) %>" class="active-filter-chip-tag" title="Remove <%= am %> filter">
          <span><%= am %></span>
          <span class="chip-remove">&times;</span>
        </a>
      <% }) %>

      <a href="/listings" class="btn btn-sm btn-link text-danger text-decoration-none small fw-semibold ms-1">
        <i class="fa-solid fa-rotate-left me-1"></i>Reset All
      </a>
    </div>
  <% } %>

  <!-- Main Content Layout Row: Sidebar Left, Listings Grid Right -->
  <div class="filter-layout-row">
    <!-- Desktop Filter Sidebar -->
    <aside class="listings-filter-sidebar d-none d-lg-block" id="desktopFilterSidebar" aria-label="Filters sidebar">
      <div class="filter-sidebar-header">
        <h3 class="filter-sidebar-title">
          <i class="fa-solid fa-sliders text-primary"></i>
          <span>Filter Stays</span>
        </h3>
        <% if (activeFilterCount > 0) { %>
          <a href="/listings" class="small text-danger text-decoration-none fw-semibold">Reset (<%= activeFilterCount %>)</a>
        <% } %>
      </div>

      <%- include('../includes/filter-form-content.ejs', {
        idPrefix: 'desktop',
        formId: 'desktopFilterForm',
        currentCategory,
        categories,
        propertyTypes,
        searchQuery,
        destination,
        minPrice,
        maxPrice,
        dbMinPrice,
        dbMaxPrice,
        minRating,
        guests,
        bedrooms,
        bathrooms,
        propertyType,
        hostVerification,
        instantBook,
        sortBy,
        allAmenities,
        selectedAmenities
      }) %>
    </aside>

    <!-- Main Listings Area -->
    <div class="flex-grow-1" id="listingsMainCol">
      <!-- Empty State -->
      <% if (allListings.length === 0) { %>
        <div class="empty-search-card reveal-on-scroll">
          <div class="empty-search-icon">
            <i class="fa-solid fa-compass"></i>
          </div>
          <h2 class="empty-search-title"><%= t('filters.noResultsFound') %></h2>
          <p class="empty-search-desc">
            <% if (searchQuery) { %>
              We couldn't find any stays matching <strong>"<%= searchQuery %>"</strong> with your current filter selections.
            <% } else { %>
              <%= t('filters.tryAdjustingFilters') %>
            <% } %>
          </p>

          <div class="empty-suggestions-label">Explore popular getaway styles:</div>
          <div class="empty-category-chips">
            <a href="/listings?category=Beach" class="btn btn-outline-secondary btn-sm rounded-pill">
              <i class="fa-solid fa-umbrella-beach me-1 text-primary"></i> Beach Escapes
            </a>
            <a href="/listings?category=Villa" class="btn btn-outline-secondary btn-sm rounded-pill">
              <i class="fa-solid fa-house-chimney-window me-1 text-primary"></i> Luxury Villas
            </a>
            <a href="/listings?category=Mountain" class="btn btn-outline-secondary btn-sm rounded-pill">
              <i class="fa-solid fa-mountain me-1 text-primary"></i> Mountain Cabins
            </a>
            <a href="/listings?category=City" class="btn btn-outline-secondary btn-sm rounded-pill">
              <i class="fa-solid fa-city me-1 text-primary"></i> Urban Apartments
            </a>
          </div>

          <div class="d-flex justify-content-center gap-3">
            <a href="/listings" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
              <i class="fa-solid fa-rotate-left me-1"></i> <%= t('filters.resetFilters') %>
            </a>
          </div>
        </div>
      <% } else { %>

        <!-- Listings Grid with Stagger Reveal -->
        <div class="listings-grid-container reveal-stagger">
          <% for(let listing of allListings) { %>
            <div class="listing-card-wrapper">
              <div class="listing-card-media">
                <a href="/listings/<%= listing._id %>" aria-label="View <%= listing.title %>">
                  <img 
                    src="<%= (listing.image && listing.image.url) ? listing.image.url : (listing.photos && listing.photos[0] && (listing.photos[0].url || listing.photos[0])) || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80' %>" 
                    alt="<%= listing.title %>" 
                    loading="lazy"
                    onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80';"
                  />
                </a>

                <!-- Wishlist toggle -->
                <form action="/wishlist/<%= listing._id %>/toggle" method="POST" class="d-inline">
                  <button type="submit" class="listing-wishlist-toggle" aria-label="Save listing">
                    <i class="fa-regular fa-heart"></i>
                  </button>
                </form>

                <span class="listing-category-badge"><%= listing.category %></span>
                <% if (listing.instantBook) { %>
                  <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2 rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.7rem;">
                    <i class="fa-solid fa-bolt me-1"></i>Instant
                  </span>
                <% } %>
              </div>

              <a href="/listings/<%= listing._id %>" class="text-decoration-none text-reset listing-card-body">
                <div class="listing-card-header">
                  <div class="listing-card-location">
                    <i class="fa-solid fa-location-dot text-primary me-1"></i><%= listing.location %>, <%= listing.country %>
                  </div>
                  <div class="listing-rating-badge">
                    <i class="fa-solid fa-star"></i>
                    <span><%= listing.averageRating ? listing.averageRating.toFixed(1) : '4.9' %></span>
                  </div>
                </div>
                
                <div class="listing-card-title"><%= listing.title %></div>

                <div class="small text-muted mb-2 d-flex align-items-center gap-2 flex-wrap">
                  <% if (listing.propertyType) { %>
                    <span><i class="fa-solid fa-hotel me-1 text-muted"></i><%= listing.propertyType %></span>
                    <span>&middot;</span>
                  <% } %>
                  <span><%= listing.guests || 2 %> guests</span>
                  <% if (listing.bedrooms) { %>
                    <span>&middot;</span>
                    <span><%= listing.bedrooms %> beds</span>
                  <% } %>
                </div>

                <% if (listing.owner) { %>
                  <div class="small text-muted mb-2 d-flex align-items-center gap-1.5 flex-wrap">
                    <img src="<%= listing.owner.avatar || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=60&q=80' %>" alt="host" class="rounded-circle" style="width: 18px; height: 18px; object-fit: cover;">
                    <span class="text-truncate">Hosted by <%= (listing.owner.firstName ? (listing.owner.firstName + ' ' + listing.owner.lastName) : listing.owner.username) %></span>
                    <% if (listing.owner.hostVerification && listing.owner.hostVerification.status === 'verified') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill py-0 px-1.5" style="font-size: 0.65rem;" title="Verified Host">
                        <i class="fa-solid fa-circle-check"></i> Verified
                      </span>
                    <% } %>
                    <% if (listing.owner.superhost && listing.owner.superhost.isSuperhost) { %>
                      <span class="badge-superhost" style="font-size: 0.65rem; padding: 0.15rem 0.5rem;" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= listing.owner.superhost.badgeReason || '⭐ Superhost' %>">
                        ⭐ Superhost
                      </span>
                    <% } %>
                  </div>
                <% } %>

                <div class="listing-card-footer">
                  <div>
                    <% const priceDisplay = (typeof getPriceDisplay === 'function') ? getPriceDisplay(listing.price) : { formattedTarget: `₹${Number(listing.price).toLocaleString('en-IN')}`, isConverted: false, formattedBase: `₹${Number(listing.price).toLocaleString('en-IN')}` }; %>
                    <span class="listing-price-tag"><%= priceDisplay.formattedTarget %></span>
                    <span class="listing-price-period">/ night</span>
                    <% if (priceDisplay.isConverted) { %>
                      <div class="text-muted" style="font-size: 0.68rem; line-height: 1;">(~<%= priceDisplay.formattedBase %>)</div>
                    <% } %>
                  </div>
                  <span class="card-book-action">Book stay &rarr;</span>
                </div>
              </a>
            </div>
          <% } %>
        </div>

        <!-- Pagination Controls -->
        <% if (totPages > 1) { %>
          <div class="wander-pagination-wrapper">
            <nav class="wander-pagination" aria-label="Listings pagination">
              <!-- Previous Button -->
              <a 
                href="<%= currPage > 1 ? getFilterUrl({ page: currPage - 1 }) : '#' %>" 
                class="wander-page-item <%= currPage <= 1 ? 'disabled' : '' %>"
                aria-label="Previous page"
              >
                <i class="fa-solid fa-chevron-left me-1"></i> Prev
              </a>

              <!-- Page Numbers -->
              <% for(let p = 1; p <= totPages; p++) { %>
                <a 
                  href="<%= getFilterUrl({ page: p }) %>" 
                  class="wander-page-item <%= currPage === p ? 'active' : '' %>"
                  aria-label="Page <%= p %>"
                  aria-current="<%= currPage === p ? 'page' : 'false' %>"
                >
                  <%= p %>
                </a>
              <% } %>

              <!-- Next Button -->
              <a 
                href="<%= currPage < totPages ? getFilterUrl({ page: currPage + 1 }) : '#' %>" 
                class="wander-page-item <%= currPage >= totPages ? 'disabled' : '' %>"
                aria-label="Next page"
              >
                Next <i class="fa-solid fa-chevron-right ms-1"></i>
              </a>
            </nav>
          </div>
        <% } %>

      <% } %>
    </div>
  </div>
</div>

<!-- Floating Filter Button for Mobile -->
<div class="d-lg-none position-fixed bottom-0 start-50 translate-middle-x mb-4 z-3">
  <button 
    type="button" 
    class="btn btn-dark rounded-pill shadow-lg px-4 py-2 d-flex align-items-center gap-2 fw-semibold border border-light-subtle"
    data-bs-toggle="offcanvas" 
    data-bs-target="#mobileFilterDrawer" 
    aria-controls="mobileFilterDrawer"
    style="backdrop-filter: blur(8px); background: rgba(15, 23, 42, 0.92);"
  >
    <i class="fa-solid fa-sliders text-primary"></i>
    <span>Filters</span>
    <% if (activeFilterCount > 0) { %>
      <span class="badge bg-primary rounded-pill"><%= activeFilterCount %></span>
    <% } %>
  </button>
</div>

<!-- Mobile Filter Bottom Sheet / Offcanvas Drawer -->
<div class="offcanvas offcanvas-bottom mobile-filter-drawer d-lg-none" tabindex="-1" id="mobileFilterDrawer" aria-labelledby="mobileFilterDrawerLabel">
  <div class="offcanvas-header border-bottom">
    <div class="d-flex align-items-center gap-2">
      <i class="fa-solid fa-sliders text-primary"></i>
      <h5 class="offcanvas-title fw-bold" id="mobileFilterDrawerLabel">Filters</h5>
      <% if (activeFilterCount > 0) { %>
        <span class="badge bg-primary rounded-pill"><%= activeFilterCount %></span>
      <% } %>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>

  <div class="offcanvas-body p-0">
    <%- include('../includes/filter-form-content.ejs', {
      idPrefix: 'mobile',
      formId: 'mobileFilterForm',
      currentCategory,
      categories,
      propertyTypes,
      searchQuery,
      destination,
      minPrice,
      maxPrice,
      dbMinPrice,
      dbMaxPrice,
      minRating,
      guests,
      bedrooms,
      bathrooms,
      propertyType,
      hostVerification,
      instantBook,
      sortBy,
      allAmenities,
      selectedAmenities
    }) %>
  </div>
</div>

<script src="/js/filters.js"></script>