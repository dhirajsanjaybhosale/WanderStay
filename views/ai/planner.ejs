<% layout('/layouts/boilerplate.ejs') %>

<div class="container-max my-4">
  <!-- Hero Section -->
  <div class="ai-planner-hero mb-4 reveal-on-scroll">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <div class="ai-recommendation-badge mb-3">
          <i class="fa-solid fa-wand-magic-sparkles text-warning"></i>
          <span>WanderStay AI Travel Concierge</span>
        </div>
        <h1 class="display-6 fw-bold mb-2 text-balance" style="font-family: var(--font-display, 'Outfit', sans-serif);">
          Smart Itinerary & Travel Planner
        </h1>
        <p class="text-muted mb-3" style="font-size: 1.05rem; max-width: 650px; line-height: 1.6;">
          Design an extraordinary, personalized day-by-day vacation itinerary featuring structured morning, afternoon, and evening phases, local dining secrets, and hand-matched WanderStay properties.
        </p>

        <!-- Quick Destination Pills -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <span class="small text-muted fw-semibold"><i class="fa-solid fa-compass text-primary me-1"></i>Quick Picks:</span>
          <% ['Goa', 'Manali', 'Bali', 'Paris', 'Kashmir', 'Dubai', 'Amalfi Coast', 'Kyoto'].forEach(qp => { %>
            <button 
              type="button" 
              class="btn btn-sm btn-outline-secondary rounded-pill py-0.5 px-2.5 quick-dest-pill" 
              style="font-size: 0.78rem;"
              data-dest="<%= qp %>"
            >
              <%= qp %>
            </button>
          <% }) %>
        </div>
      </div>

      <div class="col-lg-4 text-lg-end">
        <div class="p-3 bg-body-tertiary rounded-4 border border-theme text-start d-inline-block w-100" style="max-width: 320px;">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">
              <i class="fa-solid fa-circle-check me-1"></i>Real DB Stays
            </span>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1">
              <i class="fa-solid fa-bolt me-1"></i>Instant AI
            </span>
          </div>
          <div class="small text-muted">
            Combines real WanderStay database listings with personalized AI travel itineraries.
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Planner Form Card -->
  <div class="glass-card p-4 p-md-5 mb-5 reveal-on-scroll">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <h4 class="fw-bold mb-1 d-flex align-items-center gap-2">
          <i class="fa-solid fa-sliders text-primary"></i> Trip Preferences
        </h4>
        <p class="text-muted small mb-0">Fill in your dream trip parameters to generate a custom itinerary.</p>
      </div>
      <% if (typeof recentPlans !== 'undefined' && recentPlans.length > 0) { %>
        <div class="dropdown">
          <button class="btn btn-outline-secondary btn-sm rounded-pill dropdown-toggle" type="button" id="recentPlansDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-solid fa-clock-rotate-left me-1"></i> Recent Plans (<%= recentPlans.length %>)
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-lg rounded-3 border-0 p-2" aria-labelledby="recentPlansDropdown">
            <% recentPlans.forEach(rp => { %>
              <li>
                <a class="dropdown-item rounded-2 py-1.5 small" href="/ai-planner/<%= rp._id %>">
                  <strong><%= rp.destination %></strong> (<%= rp.days %> days • <%= rp.travelStyle || rp.travelType %>)
                </a>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>
    </div>

    <form id="planner-form" action="/ai-planner" method="POST" class="needs-validation" novalidate>
      <div class="row g-4">
        <!-- Destination -->
        <div class="col-md-6 col-lg-4">
          <label for="destInput" class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.04em;">
            <i class="fa-solid fa-location-dot text-primary me-1"></i>Destination
          </label>
          <div class="input-group">
            <span class="input-group-text bg-body-tertiary border-theme"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
            <input 
              id="destInput" 
              name="destination" 
              type="text" 
              placeholder="e.g. Manali, Bali, Paris, Goa" 
              class="form-control border-theme" 
              value="<%= (typeof inputs !== 'undefined' && inputs.destination) || '' %>"
              required 
            />
          </div>
          <div class="invalid-feedback">Please enter a travel destination.</div>
        </div>

        <!-- Travel Dates -->
        <div class="col-md-6 col-lg-4">
          <label class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.04em;">
            <i class="fa-regular fa-calendar-days text-primary me-1"></i>Travel Dates
          </label>
          <div class="input-group">
            <input 
              type="date" 
              id="startDate" 
              name="startDate" 
              class="form-control border-theme" 
              value="<%= (typeof inputs !== 'undefined' && inputs.startDate) || '' %>"
              title="Start Date"
            />
            <span class="input-group-text bg-body-tertiary border-theme text-muted small">&rarr;</span>
            <input 
              type="date" 
              id="endDate" 
              name="endDate" 
              class="form-control border-theme" 
              value="<%= (typeof inputs !== 'undefined' && inputs.endDate) || '' %>"
              title="End Date"
            />
          </div>
          <div class="form-text small text-muted" id="dateCalcNote">Dates auto-calculate trip duration</div>
        </div>

        <!-- Duration (Days) -->
        <div class="col-md-4 col-lg-2">
          <label for="daysInput" class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.04em;">
            <i class="fa-solid fa-sun text-warning me-1"></i>Days (1-14)
          </label>
          <input 
            id="daysInput" 
            name="days" 
            type="number" 
            min="1" 
            max="14" 
            value="<%= (typeof inputs !== 'undefined' && inputs.days) || 3 %>" 
            class="form-control border-theme" 
            required 
          />
        </div>

        <!-- Number of Travelers -->
        <div class="col-md-4 col-lg-2">
          <label for="travelersInput" class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.04em;">
            <i class="fa-solid fa-users text-primary me-1"></i>Travelers
          </label>
          <select id="travelersInput" name="travelers" class="form-select border-theme">
            <% [1, 2, 3, 4, 5, 6, 8, 10].forEach(n => { %>
              <option value="<%= n %>" <%= (typeof inputs !== 'undefined' && Number(inputs.travelers) === n) ? 'selected' : (n === 2 ? 'selected' : '') %>>
                <%= n %> <%= n === 1 ? 'Traveler' : 'Travelers' %>
              </option>
            <% }) %>
          </select>
        </div>

        <!-- Total Budget -->
        <div class="col-md-4 col-lg-4">
          <label for="budgetInput" class="form-label fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.04em;">
            <i class="fa-solid fa-coins text-success me-1"></i>Total Budget (<%= typeof baseSymbol !== 'undefined' ? baseSymbol : '₹' %>)
          </label>
          <div class="input-group">
            <span class="input-group-text bg-body-tertiary border-theme fw-bold text-success"><%= typeof baseSymbol !== 'undefined' ? baseSymbol : '₹' %></span>
            <input 
              id="budgetInput" 
              name="budget" 
              type="number" 
              min="1000" 
              step="500"
              placeholder="35000" 
              value="<%= (typeof inputs !== 'undefined' && inputs.budget) || '' %>"
              class="form-control border-theme" 
              required 
            />
          </div>
          <div class="form-text small text-muted">Estimated budget for stays, dining, and activities</div>
        </div>

        <!-- Travel Style Grid -->
        <div class="col-12">
          <label class="form-label fw-semibold small text-muted text-uppercase mb-2" style="letter-spacing: 0.04em;">
            <i class="fa-solid fa-compass-drafting text-primary me-1"></i>Select Travel Style
          </label>
          <div class="row g-2">
            <% 
              const travelStyles = [
                { id: 'Adventure', icon: 'fa-solid fa-person-hiking', label: 'Adventure', desc: 'Thrills & nature trails' },
                { id: 'Luxury', icon: 'fa-solid fa-crown', label: 'Luxury', desc: 'Fine dining & private tours' },
                { id: 'Budget', icon: 'fa-solid fa-wallet', label: 'Budget', desc: 'Smart & cost-effective' },
                { id: 'Family', icon: 'fa-solid fa-people-roof', label: 'Family', desc: 'Kid-friendly & relaxed' },
                { id: 'Couples', icon: 'fa-solid fa-heart', label: 'Couples', desc: 'Romantic & intimate' },
                { id: 'Nature', icon: 'fa-solid fa-tree', label: 'Nature', desc: 'Scenic vistas & wildlife' },
                { id: 'Food', icon: 'fa-solid fa-utensils', label: 'Food', desc: 'Culinary tours & street food' },
                { id: 'History', icon: 'fa-solid fa-landmark-dome', label: 'History', desc: 'Heritage & ancient forts' }
              ];
              const selectedStyle = (typeof inputs !== 'undefined' && inputs.travelStyle) || 'Adventure';
            %>
            <% travelStyles.forEach(st => { %>
              <div class="col-6 col-sm-4 col-md-3">
                <input 
                  type="radio" 
                  class="btn-check" 
                  name="travelStyle" 
                  id="style_<%= st.id %>" 
                  value="<%= st.id %>" 
                  <%= selectedStyle === st.id ? 'checked' : '' %>
                />
                <label class="ai-style-card w-100 h-100" for="style_<%= st.id %>">
                  <i class="<%= st.icon %> fs-4"></i>
                  <span><%= st.label %></span>
                  <small class="text-muted fw-normal" style="font-size: 0.7rem;"><%= st.desc %></small>
                </label>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Interests Multi-Select -->
        <div class="col-12">
          <label class="form-label fw-semibold small text-muted text-uppercase mb-2" style="letter-spacing: 0.04em;">
            <i class="fa-solid fa-tags text-primary me-1"></i>Trip Interests (Select All That Apply)
          </label>
          <div class="d-flex flex-wrap gap-2">
            <% 
              const interestOptions = [
                { id: 'Nature', label: '🌲 Nature & Wildlife' },
                { id: 'Food', label: '🍲 Food & Culinary' },
                { id: 'History', label: '🏛️ History & Forts' },
                { id: 'Beach', label: '🏖️ Beaches & Islands' },
                { id: 'Mountains', label: '🏔️ Mountain Trekking' },
                { id: 'Photography', label: '📸 Scenic Photography' },
                { id: 'Nightlife', label: '🌙 Nightlife & Music' },
                { id: 'Shopping', label: '🛍️ Local Bazaars' },
                { id: 'Wellness', label: '🧘 Spa & Wellness' }
              ];
              const chosenInterests = (typeof inputs !== 'undefined' && inputs.interests) || ['Nature', 'Food'];
            %>
            <% interestOptions.forEach(intOpt => { 
                 const isChecked = Array.isArray(chosenInterests) && (chosenInterests.includes(intOpt.id) || chosenInterests.includes(intOpt.label));
            %>
              <div>
                <input 
                  type="checkbox" 
                  class="btn-check" 
                  name="interests" 
                  id="int_<%= intOpt.id %>" 
                  value="<%= intOpt.id %>"
                  <%= isChecked ? 'checked' : '' %>
                />
                <label class="interest-toggle-chip" for="int_<%= intOpt.id %>">
                  <%= intOpt.label %>
                </label>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="col-12 pt-3 border-top d-flex justify-content-end">
          <button class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm" type="submit" id="generatePlanBtn">
            <i class="fa-solid fa-wand-magic-sparkles me-2"></i> Generate Smart Itinerary
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Generated Itinerary Results Section -->
  <% if (plan) { %>
    <section class="itinerary-results-wrapper mb-5 reveal-on-scroll" id="planResults">
      <!-- Results Action Bar -->
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 p-4 glass-card rounded-4">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1.5 flex-wrap">
            <span class="ai-recommendation-badge">
              <i class="fa-solid fa-sparkles"></i> AI Generated Itinerary
            </span>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1">
              <%= plan.days %> Days
            </span>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1">
              <%= plan.travelStyle || 'Adventure' %> Style
            </span>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1">
              <%= plan.travelers || 2 %> Travelers
            </span>
          </div>
          <h2 class="fw-bold mb-1" style="font-family: var(--font-display, 'Outfit', sans-serif);">
            Trip Itinerary: <%= plan.destination %>
          </h2>
          <div class="text-muted small">
            Estimated Trip Budget: <strong><%= typeof formatCurrency === 'function' ? formatCurrency(plan.budget) : ('₹ ' + Number(plan.budget).toLocaleString('en-IN')) %></strong>
            <% if (plan.startDate && plan.endDate) { %>
              &bull; <%= new Date(plan.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %> &mdash; <%= new Date(plan.endDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
            <% } %>
          </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
          <button class="btn btn-outline-secondary rounded-pill px-3" onclick="window.print()">
            <i class="fa-solid fa-print me-1"></i> Print Itinerary
          </button>
          <a href="/listings?q=<%= encodeURIComponent(plan.destination) %>" class="btn btn-primary rounded-pill px-3">
            <i class="fa-solid fa-compass me-1"></i> Explore Stays
          </a>
        </div>
      </div>

      <!-- Itinerary Summary Box -->
      <% if (plan.itinerary && plan.itinerary.summary) { %>
        <div class="p-3 mb-4 bg-body-tertiary rounded-4 border border-theme d-flex align-items-start gap-3">
          <div class="rounded-circle d-flex align-items-center justify-content-center text-primary bg-primary-subtle flex-shrink-0" style="width: 40px; height: 40px;">
            <i class="fa-solid fa-lightbulb"></i>
          </div>
          <div class="small">
            <div class="fw-bold text-body mb-0.5">Concierge Overview:</div>
            <div class="text-muted"><%= plan.itinerary.summary %></div>
          </div>
        </div>
      <% } %>

      <!-- ==========================================================================
           CRITICAL DISTINCTION: SECTION 1 - REAL WANDERSTAY DATABASE PROPERTIES
           ========================================================================== -->
      <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
          <div>
            <div class="d-flex align-items-center gap-2 mb-1">
              <span class="real-stay-verified-badge">
                <i class="fa-solid fa-circle-check"></i> Real WanderStay Inventory
              </span>
              <span class="badge bg-success-subtle text-success rounded-pill" style="font-size: 0.7rem;">Live Database</span>
            </div>
            <h4 class="fw-bold mb-0">Suggested WanderStay Properties in <%= plan.destination %></h4>
            <p class="text-muted small mb-0">Real bookable accommodations from WanderStay database with live pricing & real-time booking availability.</p>
          </div>
          <a href="/listings?q=<%= encodeURIComponent(plan.destination) %>" class="btn btn-outline-success btn-sm rounded-pill px-3">
            View All in <%= plan.destination %> &rarr;
          </a>
        </div>

        <% if (realListings && realListings.length > 0) { %>
          <div class="row g-3">
            <% realListings.forEach(stay => { %>
              <div class="col-md-6 col-lg-4 col-xl-3">
                <div class="real-listing-card-mini h-100 d-flex flex-column">
                  <div class="position-relative">
                    <img 
                      src="<%= (stay.image && stay.image.url) ? stay.image.url : (stay.photos && stay.photos[0] && (stay.photos[0].url || stay.photos[0])) || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80' %>" 
                      alt="<%= stay.title %>" 
                      class="w-100" 
                      style="height: 160px; object-fit: cover;"
                      loading="lazy"
                    />
                    <span class="badge bg-success position-absolute top-0 start-0 m-2 rounded-pill px-2 py-0.5 shadow-sm" style="font-size: 0.65rem;">
                      <i class="fa-solid fa-check me-1"></i>Verified Stay
                    </span>
                    <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 end-0 m-2 rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">
                      <i class="fa-solid fa-star text-warning me-1"></i><%= stay.averageRating ? stay.averageRating.toFixed(1) : '4.9' %>
                    </span>
                  </div>
                  <div class="p-3 d-flex flex-column flex-grow-1">
                    <div class="small text-muted mb-1 text-truncate">
                      <i class="fa-solid fa-location-dot text-primary me-1"></i><%= stay.location %>, <%= stay.country %>
                    </div>
                    <h6 class="fw-bold mb-2 text-truncate" title="<%= stay.title %>"><%= stay.title %></h6>
                    
                    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                      <div>
                        <% const stayPriceDisp = (typeof getPriceDisplay === 'function') ? getPriceDisplay(stay.price) : { formattedTarget: '₹ ' + Number(stay.price).toLocaleString('en-IN') }; %>
                        <span class="fw-bold text-body"><%= stayPriceDisp.formattedTarget %></span>
                        <span class="text-muted small">/ night</span>
                      </div>
                      <a href="/listings/<%= stay._id %>" class="btn btn-sm btn-primary rounded-pill px-2.5">
                        Book Stay
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="p-4 bg-body-tertiary rounded-4 text-center border">
            <i class="fa-solid fa-hotel text-muted fs-3 mb-2"></i>
            <p class="mb-2 text-muted">No specific properties matching this location yet.</p>
            <a href="/listings" class="btn btn-sm btn-outline-primary rounded-pill">Browse Global Collection</a>
          </div>
        <% } %>
      </div>

      <!-- ==========================================================================
           CRITICAL DISTINCTION: SECTION 2 - AI GENERATED DAY-BY-DAY ITINERARY
           ========================================================================== -->
      <div class="row g-4">
        <!-- Main Itinerary Days Timeline Column -->
        <div class="col-lg-8">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center gap-2">
              <span class="ai-recommendation-badge">
                <i class="fa-solid fa-wand-magic-sparkles"></i> AI Generated
              </span>
              <h4 class="fw-bold mb-0">Daily Schedule (Morning &bull; Afternoon &bull; Evening)</h4>
            </div>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1">
              <%= (plan.itinerary && plan.itinerary.itinerary && plan.itinerary.itinerary.length) || plan.days %> Days Plan
            </span>
          </div>

          <% if (plan.itinerary && plan.itinerary.itinerary && Array.isArray(plan.itinerary.itinerary)) { %>
            <% for (let day of plan.itinerary.itinerary) { %>
              <div class="itinerary-day-box">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <div class="itinerary-day-badge mb-0">Day <%= day.day %></div>
                  <span class="badge bg-body-tertiary text-body border rounded-pill px-2 py-0.5 small" style="font-size: 0.72rem;">
                    <i class="fa-solid fa-robot text-primary me-1"></i>AI Suggested Phase
                  </span>
                </div>
                
                <h5 class="fw-bold mb-3"><%= day.title || ('Day ' + day.day + ' Highlights') %></h5>

                <!-- Morning / Afternoon / Evening Structured Phases -->
                <div class="d-flex flex-column gap-2.5">
                  <!-- Morning -->
                  <% if (day.morning) { %>
                    <div class="time-phase-box time-phase-morning">
                      <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="time-phase-badge bg-warning-subtle text-warning-emphasis">
                          <i class="fa-solid fa-sun me-1"></i>Morning
                        </span>
                        <span class="text-muted small" style="font-size: 0.75rem;"><%= day.morning.time || '08:30 AM – 12:00 PM' %></span>
                      </div>
                      <div class="fw-medium text-body small mb-1"><%= day.morning.activity %></div>
                      <% if (day.morning.highlight) { %>
                        <div class="text-muted" style="font-size: 0.76rem;">
                          <i class="fa-solid fa-camera text-warning me-1"></i>Highlight: <em><%= day.morning.highlight %></em>
                        </div>
                      <% } %>
                    </div>
                  <% } %>

                  <!-- Afternoon -->
                  <% if (day.afternoon) { %>
                    <div class="time-phase-box time-phase-afternoon">
                      <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="time-phase-badge bg-info-subtle text-info-emphasis">
                          <i class="fa-solid fa-cloud-sun me-1"></i>Afternoon
                        </span>
                        <span class="text-muted small" style="font-size: 0.75rem;"><%= day.afternoon.time || '12:30 PM – 04:30 PM' %></span>
                      </div>
                      <div class="fw-medium text-body small mb-1"><%= day.afternoon.activity %></div>
                      <% if (day.afternoon.highlight) { %>
                        <div class="text-muted" style="font-size: 0.76rem;">
                          <i class="fa-solid fa-compass text-info me-1"></i>Highlight: <em><%= day.afternoon.highlight %></em>
                        </div>
                      <% } %>
                    </div>
                  <% } %>

                  <!-- Evening -->
                  <% if (day.evening) { %>
                    <div class="time-phase-box time-phase-evening">
                      <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="time-phase-badge bg-purple-subtle text-purple-emphasis" style="background: rgba(139, 92, 246, 0.12); color: #7c3aed;">
                          <i class="fa-solid fa-moon me-1"></i>Evening
                        </span>
                        <span class="text-muted small" style="font-size: 0.75rem;"><%= day.evening.time || '05:00 PM – 09:30 PM' %></span>
                      </div>
                      <div class="fw-medium text-body small mb-1"><%= day.evening.activity %></div>
                      <% if (day.evening.highlight) { %>
                        <div class="text-muted" style="font-size: 0.76rem;">
                          <i class="fa-solid fa-star text-purple me-1" style="color: #7c3aed;"></i>Highlight: <em><%= day.evening.highlight %></em>
                        </div>
                      <% } %>
                    </div>
                  <% } %>

                  <!-- Fallback list for legacy activities array -->
                  <% if (!day.morning && !day.afternoon && !day.evening && day.activities) { %>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                      <% (day.activities || []).forEach(act => { %>
                        <li class="d-flex align-items-start gap-2 small">
                          <i class="fa-solid fa-circle-dot text-primary mt-1" style="font-size: 0.65rem;"></i>
                          <span><%= typeof act === 'object' ? (act.time ? (act.time + ' — ' + act.name) : act.name) : act %></span>
                        </li>
                      <% }) %>
                    </ul>
                  <% } %>
                </div>
              </div>
            <% } %>
          <% } else { %>
            <div class="glass-card p-4 rounded-4">
              <p class="text-muted mb-0">Itinerary content generated successfully.</p>
            </div>
          <% } %>
        </div>

        <!-- Sidebar: Attractions, Food, Budget, Travel Tips Column -->
        <div class="col-lg-4">
          <!-- Recommended Places / Attractions -->
          <div class="glass-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="fw-bold mb-0">
                <i class="fa-solid fa-camera-retro text-primary me-2"></i>Must-Visit Sights
              </h5>
              <span class="badge bg-secondary-subtle text-secondary rounded-pill" style="font-size: 0.68rem;">AI Curated</span>
            </div>
            
            <div class="d-flex flex-column gap-2.5">
              <% const atts = (plan.itinerary && plan.itinerary.attractions) || []; %>
              <% if (atts.length > 0) { %>
                <% atts.forEach(att => { %>
                  <div class="p-2.5 bg-body-tertiary rounded-3 border border-theme">
                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                      <strong class="small text-body"><%= typeof att === 'object' ? att.name : att %></strong>
                      <% if (typeof att === 'object' && att.category) { %>
                        <span class="badge bg-body text-muted border rounded-pill py-0.5 px-1.5" style="font-size: 0.65rem;"><%= att.category %></span>
                      <% } %>
                    </div>
                    <% if (typeof att === 'object' && att.description) { %>
                      <div class="text-muted" style="font-size: 0.74rem;"><%= att.description %></div>
                    <% } %>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="text-muted small">Explore historic monuments, scenic lookouts, and central parks.</div>
              <% } %>
            </div>
          </div>

          <!-- Activities -->
          <div class="glass-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="fw-bold mb-0">
                <i class="fa-solid fa-person-running text-warning me-2"></i>Curated Activities
              </h5>
              <span class="badge bg-secondary-subtle text-secondary rounded-pill" style="font-size: 0.68rem;">AI Curated</span>
            </div>

            <div class="d-flex flex-column gap-2.5">
              <% const acts = (plan.itinerary && plan.itinerary.activities) || []; %>
              <% if (acts.length > 0) { %>
                <% acts.forEach(act => { %>
                  <div class="p-2.5 bg-body-tertiary rounded-3 border border-theme">
                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                      <strong class="small text-body"><%= typeof act === 'object' ? act.name : act %></strong>
                      <% if (typeof act === 'object' && act.type) { %>
                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill py-0.5 px-1.5" style="font-size: 0.65rem;"><%= act.type %></span>
                      <% } %>
                    </div>
                    <% if (typeof act === 'object' && act.tip) { %>
                      <div class="text-muted" style="font-size: 0.74rem;"><i class="fa-regular fa-lightbulb text-warning me-1"></i><%= act.tip %></div>
                    <% } %>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="text-muted small">Nature walks, walking tours, and cultural workshops.</div>
              <% } %>
            </div>
          </div>

          <!-- Food & Culinary Suggestions -->
          <div class="glass-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="fw-bold mb-0">
                <i class="fa-solid fa-utensils text-danger me-2"></i>Food Suggestions
              </h5>
              <span class="badge bg-secondary-subtle text-secondary rounded-pill" style="font-size: 0.68rem;">AI Curated</span>
            </div>

            <div class="d-flex flex-column gap-2.5">
              <% const foods = (plan.itinerary && plan.itinerary.food) || []; %>
              <% if (foods.length > 0) { %>
                <% foods.forEach(f => { %>
                  <div class="p-2.5 bg-body-tertiary rounded-3 border border-theme">
                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                      <strong class="small text-body"><%= typeof f === 'object' ? (f.meal || 'Dish') : 'Signature Dish' %></strong>
                      <% if (typeof f === 'object' && f.spot) { %>
                        <span class="badge bg-danger-subtle text-danger rounded-pill py-0.5 px-1.5" style="font-size: 0.65rem;"><%= f.spot %></span>
                      <% } %>
                    </div>
                    <div class="text-muted" style="font-size: 0.74rem;">
                      <%= typeof f === 'object' ? f.dish : f %>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="text-muted small">Local breakfast specialties, authentic heritage dining, and night street bazaars.</div>
              <% } %>
            </div>
          </div>

          <!-- Estimated Budget Breakdown -->
          <div class="glass-card p-4 mb-4">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
              <i class="fa-solid fa-chart-pie text-success"></i>Estimated Budget
            </h5>

            <% const bb = (plan.itinerary && plan.itinerary.budgetBreakdown) || {}; %>
            <div class="d-flex flex-column gap-2 small">
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted"><i class="fa-solid fa-hotel me-1 text-primary"></i>Stays & Accommodations:</span>
                <strong class="text-body">&#8377; <%= Number(bb.stayEstimate || Math.round(plan.budget * 0.45)).toLocaleString('en-IN') %></strong>
              </div>
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted"><i class="fa-solid fa-utensils me-1 text-danger"></i>Food & Dining:</span>
                <strong class="text-body">&#8377; <%= Number(bb.foodAndDining || Math.round(plan.budget * 0.25)).toLocaleString('en-IN') %></strong>
              </div>
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted"><i class="fa-solid fa-ticket me-1 text-warning"></i>Activities & Sightseeing:</span>
                <strong class="text-body">&#8377; <%= Number(bb.activitiesAndTickets || Math.round(plan.budget * 0.15)).toLocaleString('en-IN') %></strong>
              </div>
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted"><i class="fa-solid fa-taxi me-1 text-info"></i>Local Transit:</span>
                <strong class="text-body">&#8377; <%= Number(bb.localTransport || Math.round(plan.budget * 0.10)).toLocaleString('en-IN') %></strong>
              </div>
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted"><i class="fa-solid fa-shield-halved me-1 text-secondary"></i>Buffer / Contingency:</span>
                <strong class="text-body">&#8377; <%= Number(bb.buffer || Math.round(plan.budget * 0.05)).toLocaleString('en-IN') %></strong>
              </div>
              <div class="pt-2 border-top d-flex justify-content-between align-items-center fw-bold text-success fs-6">
                <span>Total Estimated Budget:</span>
                <span>&#8377; <%= Number(plan.budget).toLocaleString('en-IN') %></span>
              </div>
            </div>
          </div>

          <!-- Travel Tips -->
          <div class="glass-card p-4">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
              <i class="fa-solid fa-lightbulb text-warning"></i>Essential Travel Tips
            </h5>

            <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
              <% for (let tip of (plan.itinerary && plan.itinerary.travelTips) || [
                'Book stays in advance to secure prime locations.',
                'Carry sufficient cash for local transport and small artisan bazaars.',
                'Keep comfortable walking shoes and weather-appropriate layers.',
                'Start morning sightseeing early to avoid crowds.'
              ]) { %>
                <li class="d-flex align-items-start gap-2">
                  <i class="fa-solid fa-circle-check text-success mt-1" style="font-size: 0.75rem;"></i>
                  <span class="text-muted"><%= tip %></span>
                </li>
              <% } %>
            </ul>
          </div>
        </div>
      </div>

      <!-- AI Recommendations vs Real Listing Transparency Disclaimer -->
      <div class="p-3 mt-4 bg-body-tertiary rounded-4 border border-theme small text-muted text-center">
        <i class="fa-solid fa-circle-info text-primary me-1"></i>
        <strong>Clarity Note:</strong> Sightseeing plans, food suggestions, and daily itineraries are curated recommendations generated by WanderStay AI. Properties displayed in the verified properties section are real, live bookable inventory from WanderStay's database.
      </div>
    </section>
  <% } %>
</div>

<script>
  (function() {
    // Quick destination pills click handler
    const destPills = document.querySelectorAll('.quick-dest-pill');
    const destInput = document.getElementById('destInput');
    if (destPills && destInput) {
      destPills.forEach(pill => {
        pill.addEventListener('click', () => {
          destInput.value = pill.getAttribute('data-dest') || '';
          destInput.focus();
        });
      });
    }

    // Auto-calculate days between startDate and endDate
    const startDateInput = document.getElementById('startDate');
    const endDateInput = document.getElementById('endDate');
    const daysInput = document.getElementById('daysInput');
    const dateCalcNote = document.getElementById('dateCalcNote');

    function updateDayCount() {
      if (!startDateInput || !endDateInput || !daysInput) return;
      const start = new Date(startDateInput.value);
      const end = new Date(endDateInput.value);

      if (!isNaN(start) && !isNaN(end) && end > start) {
        const diffDays = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
        if (diffDays >= 1 && diffDays <= 14) {
          daysInput.value = diffDays;
          if (dateCalcNote) dateCalcNote.textContent = `Calculated: ${diffDays} Days`;
        }
      }
    }

    if (startDateInput && endDateInput) {
      startDateInput.addEventListener('change', updateDayCount);
      endDateInput.addEventListener('change', updateDayCount);
    }

    // Form submission feedback
    const plannerForm = document.getElementById('planner-form');
    const generateBtn = document.getElementById('generatePlanBtn');
    if (plannerForm && generateBtn) {
      plannerForm.addEventListener('submit', (e) => {
        if (plannerForm.checkValidity()) {
          generateBtn.disabled = true;
          generateBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Curating AI Itinerary...';
        }
      });
    }

    // Auto scroll to results if present
    const planResults = document.getElementById('planResults');
    if (planResults) {
      planResults.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  })();
</script>
