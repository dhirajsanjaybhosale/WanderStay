<% layout('/layouts/boilerplate.ejs') %>

<div class="container-max my-4">
  <!-- Hero / Header -->
  <div class="ai-hero-card mb-4">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-white rounded-pill text-primary fw-bold small mb-2 shadow-xs border">
          <i class="fa-solid fa-wand-magic-sparkles"></i> AI Powered Travel Assistant
        </div>
        <h2 class="fw-bold mb-2">Smart Itinerary Generator</h2>
        <p class="text-muted mb-0">Generate a custom day-by-day vacation itinerary with recommended activities, top food spots, and daily budget estimations.</p>
      </div>
      <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
        <a href="/listings" class="btn btn-outline-dark rounded-pill px-4">Explore Stays</a>
      </div>
    </div>
  </div>

  <!-- Form -->
  <div class="card border rounded-4 p-4 p-md-5 bg-white shadow-sm mb-5">
    <h4 class="fw-bold mb-4">Plan Your Next Adventure</h4>
    <form id="planner-form" action="/ai-planner" method="POST" class="needs-validation" novalidate>
      <div class="row g-3">
        <div class="col-md-6">
          <label for="dest" class="form-label">Destination</label>
          <input 
            id="dest" 
            name="destination" 
            type="text" 
            placeholder="e.g. Manali, Bali, Paris, Goa" 
            class="form-control" 
            required 
          />
          <div class="invalid-feedback">Please enter a destination.</div>
        </div>

        <div class="col-md-3">
          <label for="budget" class="form-label">Total Budget (₹)</label>
          <input 
            id="budget" 
            name="budget" 
            type="number" 
            min="500" 
            placeholder="25000" 
            class="form-control" 
            required 
          />
          <div class="invalid-feedback">Please enter your total budget.</div>
        </div>

        <div class="col-md-3">
          <label for="days" class="form-label">Days</label>
          <input 
            id="days" 
            name="days" 
            type="number" 
            min="1" 
            max="14" 
            value="3" 
            class="form-control" 
            required 
          />
          <div class="invalid-feedback">Please specify duration (1-14 days).</div>
        </div>

        <div class="col-md-6">
          <label for="travelType" class="form-label">Travel Style</label>
          <select id="travelType" name="travelType" class="form-select" required>
            <option value="Solo">Solo Traveler</option>
            <option value="Couple" selected>Couple / Romantic</option>
            <option value="Family">Family with Kids</option>
            <option value="Friends">Group of Friends</option>
          </select>
        </div>

        <div class="col-md-6 d-flex align-items-end">
          <button class="btn btn-primary btn-lg w-100 rounded-pill" type="submit">
            <i class="fa-solid fa-wand-magic-sparkles me-2"></i> Generate Plan
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Generated Itinerary Results -->
  <% if (plan) { %>
    <section class="mt-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
          <span class="badge bg-success-subtle text-success border px-3 py-2 rounded-pill mb-2">Itinerary Ready</span>
          <h3 class="fw-bold mb-0">Trip Plan for <%= plan.destination %></h3>
          <div class="text-muted small"><%= plan.days %> Days • <%= plan.travelType %> • Budget: &#8377; <%= Number(plan.budget).toLocaleString("en-IN") %></div>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-outline-dark rounded-pill" onclick="window.print()">
            <i class="fa-solid fa-print me-1"></i> Print
          </button>
          <a href="/listings?q=<%= encodeURIComponent(plan.destination) %>" class="btn btn-primary rounded-pill">
            <i class="fa-solid fa-house-laptop me-1"></i> Find Stays in <%= plan.destination %>
          </a>
        </div>
      </div>

      <div class="row g-4">
        <!-- Daily Activities Timeline -->
        <div class="col-lg-8">
          <% if (plan.itinerary && plan.itinerary.itinerary && Array.isArray(plan.itinerary.itinerary)) { %>
            <% for (let day of plan.itinerary.itinerary) { %>
              <div class="itinerary-day-box">
                <div class="itinerary-day-badge">Day <%= day.day %></div>
                <h5 class="fw-bold mb-2"><%= day.title || 'Day Highlights & Activities' %></h5>
                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                  <% for (let act of (day.activities || [])) { %>
                    <li class="d-flex align-items-start gap-2">
                      <i class="fa-solid fa-circle-dot text-primary mt-1 small"></i>
                      <span><%= typeof act === 'object' ? (act.time ? (act.time + ' — ' + act.name) : act.name) : act %></span>
                    </li>
                  <% } %>
                </ul>
              </div>
            <% } %>
          <% } else { %>
            <div class="card p-4 rounded-4 bg-white border">
              <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;"><%= generatedText %></pre>
            </div>
          <% } %>
        </div>

        <!-- Sidebar Attractions & Tips -->
        <div class="col-lg-4">
          <!-- Attractions -->
          <div class="card border rounded-4 p-4 bg-white shadow-sm mb-4">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-camera text-primary me-2"></i>Must-See Sights</h5>
            <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
              <% for (let a of (plan.itinerary && plan.itinerary.attractions) || ['Scenic viewpoints', 'Historic Old Town', 'Local Art Bazaar']) { %>
                <li class="d-flex align-items-center gap-2">
                  <i class="fa-solid fa-location-dot text-danger"></i>
                  <span><%= a %></span>
                </li>
              <% } %>
            </ul>
          </div>

          <!-- Food & Cuisine -->
          <div class="card border rounded-4 p-4 bg-white shadow-sm mb-4">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-utensils text-primary me-2"></i>Food Recommendations</h5>
            <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
              <% for (let f of (plan.itinerary && plan.itinerary.food) || ['Traditional regional dishes', 'Popular cafe quarter', 'Night street food market']) { %>
                <li class="d-flex align-items-center gap-2">
                  <i class="fa-solid fa-bowl-food text-warning"></i>
                  <span><%= f %></span>
                </li>
              <% } %>
            </ul>
          </div>

          <!-- Travel Tips -->
          <div class="card border rounded-4 p-4 bg-white shadow-sm">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-lightbulb text-primary me-2"></i>Travel Tips</h5>
            <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
              <% for (let t of (plan.itinerary && plan.itinerary.travelTips) || ['Book tickets early during peak seasons', 'Carry light footwear for walking', 'Keep local currency handy']) { %>
                <li class="d-flex align-items-start gap-2">
                  <i class="fa-solid fa-circle-check text-success mt-1"></i>
                  <span><%= t %></span>
                </li>
              <% } %>
            </ul>
          </div>
        </div>
      </div>
    </section>
  <% } %>
</div>
