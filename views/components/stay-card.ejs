<div class="listing-card compact" tabindex="0">
  <a href="/listings/<%= listing._id %>" class="text-decoration-none text-reset" aria-label="View listing <%= listing.title %>">
    <div class="listing-media">
      <img src="<%= (listing.photos && listing.photos.length) ? listing.photos[0].url : listing.image.url %>" alt="<%= listing.title %>" />
      <button type="button" class="wishlist-btn" aria-label="Save listing"><i class="fa-regular fa-heart" aria-hidden="true"></i></button>
    </div>
    <div class="card-body p-3">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <h5 class="mb-1"><%= listing.title %></h5>
          <div class="muted small"><%= listing.location %></div>
        </div>
        <div class="text-end">
          <div class="price-tag">₹<%= listing.price %></div>
          <div class="rating-pill"><i class="fa-solid fa-star"></i> <%= (listing.averageRating || 0).toFixed(1) %></div>
        </div>
      </div>
    </div>
  </a>
</div>
