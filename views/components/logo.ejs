<%
  const logoVariant = typeof variant !== 'undefined' ? variant : 'full';
  const logoSize = typeof size !== 'undefined' ? size : 'md';
  const isFooter = logoVariant === 'footer';
  const isIconOnly = logoVariant === 'icon';
  const isMobile = logoVariant === 'mobile';
  
  let iconPx = 36;
  if (logoSize === 'sm') iconPx = 28;
  if (logoSize === 'lg') iconPx = 46;
  if (isFooter) iconPx = 40;
%>

<div class="ws-brand-mark ws-brand-<%= logoVariant %> <%= typeof className !== 'undefined' ? className : '' %>" style="display: inline-flex; align-items: center; gap: 0.65rem; text-decoration: none;">
  <!-- Custom Vector Travel Emblem: Pin + Mountain Peaks + Sheltered Arch + Compass Star -->
  <div class="ws-logo-icon-wrap" style="width: <%= iconPx %>px; height: <%= iconPx %>px; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;">
    <svg viewBox="0 0 48 48" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="WanderStay emblem" role="img">
      <defs>
        <linearGradient id="ws-emblem-grad" x1="4" y1="4" x2="44" y2="44" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#FF5A5F" />
          <stop offset="55%" stop-color="#FF7A45" />
          <stop offset="100%" stop-color="#F5A623" />
        </linearGradient>
        <linearGradient id="ws-peak-grad" x1="16" y1="12" x2="32" y2="38" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#FFFFFF" />
          <stop offset="100%" stop-color="#FFF2EE" />
        </linearGradient>
        <filter id="ws-emblem-shadow" x="2" y="2" width="44" height="44" filterUnits="userSpaceOnUse">
          <feDropShadow dx="0" dy="2" stdDeviation="2.5" flood-color="#FF5A5F" flood-opacity="0.28" />
        </filter>
      </defs>

      <!-- Outer WanderStay Pin / Discovery Trail Loop -->
      <path 
        d="M24 5C15.716 5 9 11.716 9 20C9 29.2 21.4 41.6 23.1 43.1C23.6 43.6 24.4 43.6 24.9 43.1C26.6 41.6 39 29.2 39 20C39 11.716 32.284 5 24 5Z" 
        fill="url(#ws-emblem-grad)" 
        filter="url(#ws-emblem-shadow)"
      />

      <!-- Mountain Peaks & Alpine Silhouette (Wander) -->
      <path 
        d="M24 13L15.5 25H20.2L24 19.2L27.8 25H32.5L24 13Z" 
        fill="url(#ws-peak-grad)" 
      />

      <!-- Architectural Gable Arch / Stay Shelter -->
      <path 
        d="M24 21.5L18.8 29.2H29.2L24 21.5Z" 
        fill="#111622" 
        fill-opacity="0.9"
      />

      <!-- Golden Warm Hearth / Horizon Glow -->
      <path 
        d="M24 24.5L21.2 28.5H26.8L24 24.5Z" 
        fill="url(#ws-emblem-grad)"
      />

      <!-- Guiding North Compass Star -->
      <path 
        d="M24 8.5L24.8 10.7L27 11.5L24.8 12.3L24 14.5L23.2 12.3L21 11.5L23.2 10.7L24 8.5Z" 
        fill="#FFFFFF"
      />
    </svg>
  </div>

  <% if (!isIconOnly) { %>
    <!-- Brand Wordmark -->
    <div class="ws-logo-text-group" style="display: flex; flex-direction: column; justify-content: center; line-height: 1;">
      <span class="ws-brand-title" style="font-family: 'Plus Jakarta Sans', -apple-system, sans-serif; font-weight: 800; letter-spacing: -0.03em; font-size: <%= logoSize === 'sm' ? '1.15rem' : (logoSize === 'lg' ? '1.5rem' : '1.32rem') %>; display: inline-flex; align-items: baseline;">
        <span class="ws-text-wander">Wander</span><span class="ws-text-stay" style="color: #FF5A5F; margin-left: 1px;">Stay</span>
      </span>
      <% if (isFooter) { %>
        <span class="ws-brand-tagline" style="font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted, #94A3B8); font-weight: 600; margin-top: 3px;">Wander Far • Stay Extraordinary</span>
      <% } %>
    </div>
  <% } %>
</div>
