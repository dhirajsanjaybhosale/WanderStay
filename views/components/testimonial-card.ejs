<div class="testimonial-card card p-3 h-100">
  <div class="d-flex gap-3 align-items-center">
    <img src="<%= t.avatar || 'https://i.pravatar.cc/64' %>" alt="<%= t.author %>" class="avatar-sm">
    <div>
      <strong><%= t.author %></strong>
      <div class="small text-muted"><%= t.role %></div>
    </div>
  </div>
  <blockquote class="mt-3 mb-0">“<%= t.quote %>”</blockquote>
</div>
