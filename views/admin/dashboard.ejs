                  <tr>
                    <th>Ref #</th>
                    <th>Property Stay</th>
                    <th>Guest / Traveler</th>
                    <th>Stay Dates</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Razorpay Details</th>
