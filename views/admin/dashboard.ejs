                                <i class="fa-solid fa-ban"></i>
                              </button>
                            </form>
                          <% } else { %>
                            <span class="small text-muted">Cancelled</span>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
