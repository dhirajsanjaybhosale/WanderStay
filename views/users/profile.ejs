              <div class="col-md-6">
                <label for="confirmPassword" class="form-label">Confirm New Password</label>
                <div class="input-group">
                  <span class="input-group-text bg-body-tertiary border-end-0"><i class="fa-solid fa-check-double text-muted"></i></span>
                  <input 
                    type="password" 
                    class="form-control border-start-0" 
                    id="confirmPassword" 
                    name="confirmPassword" 
                    placeholder="Confirm new password" 
                    required 
                    minlength="6"
                  />
                  <button class="btn btn-outline-secondary toggle-pwd-btn" type="button" data-target="confirmPassword">
                    <i class="fa-regular fa-eye"></i>
                  </button>
                </div>
              </div>

              <div class="col-12 mt-3">
                <div class="password-match-hint small text-muted" id="passwordMatchHint"></div>
              </div>

              <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-primary rounded-pill px-4" id="submitPasswordBtn">
                  <i class="fa-solid fa-shield-halved me-1"></i>Update Password
