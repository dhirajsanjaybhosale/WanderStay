<% layout("/layouts/boilerplate.ejs") %>

<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <div class="mb-3 d-flex justify-content-center">
        <%- include('../components/logo.ejs', { variant: 'icon', size: 'lg' }) %>
      </div>
      <h2 class="fw-bold"><%= t('forms.joinWanderstay') %></h2>
      <p><%= t('forms.signupSubtitle') %></p>
    </div>

    <form action="/signup" method="POST" novalidate class="needs-validation">
      <!-- Role Picker -->
      <div class="mb-3">
        <label class="form-label small fw-bold text-muted text-uppercase mb-2"><%= t('forms.accountType') %></label>
        <div class="row g-2">
          <div class="col-6">
            <input type="radio" class="btn-check" name="role" id="roleGuest" value="guest" <%= (typeof selectedRole !== 'undefined' && selectedRole === 'host') ? '' : 'checked' %> autocomplete="off">
            <label class="btn btn-outline-secondary w-100 p-3 text-start rounded-3 h-100 d-flex flex-column justify-content-between" for="roleGuest">
              <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                  <i class="fa-solid fa-compass text-primary"></i>
                  <span class="fw-bold text-body"><%= t('forms.traveler') %></span>
                </div>
                <div class="small text-muted" style="font-size: 0.76rem;"><%= t('forms.travelerDesc') %></div>
              </div>
            </label>
          </div>
          <div class="col-6">
            <input type="radio" class="btn-check" name="role" id="roleHost" value="host" <%= (typeof selectedRole !== 'undefined' && selectedRole === 'host') ? 'checked' : '' %> autocomplete="off">
            <label class="btn btn-outline-secondary w-100 p-3 text-start rounded-3 h-100 d-flex flex-column justify-content-between" for="roleHost">
              <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                  <i class="fa-solid fa-house-chimney-user text-primary"></i>
                  <span class="fw-bold text-body"><%= t('forms.host') %></span>
                </div>
                <div class="small text-muted" style="font-size: 0.76rem;"><%= t('forms.hostDesc') %></div>
              </div>
            </label>
          </div>
        </div>
      </div>

      <div class="row g-2 mb-3">
        <div class="col-6">
          <label for="firstName" class="form-label"><%= t('forms.firstName') %></label>
          <input
            name="firstName"
            id="firstName"
            type="text"
            class="form-control"
            placeholder="<%= t('forms.firstName') %>"
          />
        </div>
        <div class="col-6">
          <label for="lastName" class="form-label"><%= t('forms.lastName') %></label>
          <input
            name="lastName"
            id="lastName"
            type="text"
            class="form-control"
            placeholder="<%= t('forms.lastName') %>"
          />
        </div>
      </div>

      <div class="mb-3">
        <label for="username" class="form-label"><%= t('forms.username') %></label>
        <input
          name="username"
          id="username"
          type="text"
          class="form-control"
          placeholder="<%= t('forms.chooseUsername') %>"
          required
        />
        <div class="invalid-feedback"><%= t('forms.chooseUsername') %></div>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label"><%= t('forms.email') %></label>
        <input
          name="email"
          id="email"
          type="email"
          class="form-control"
          placeholder="name@example.com"
          required
        />
        <div class="invalid-feedback">Please enter a valid email address.</div>
      </div>

      <div class="mb-4">
        <label for="password" class="form-label"><%= t('forms.password') %></label>
        <input
          name="password"
          id="password"
          type="password"
          class="form-control"
          placeholder="At least 6 characters"
          minlength="6"
          required
        />
        <div class="invalid-feedback">Password must be at least 6 characters.</div>
      </div>

      <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill mb-3">
        <i class="fa-solid fa-check me-1"></i> <%= t('forms.createAccount') %>
      </button>
    </form>

    <div class="text-center text-muted small mt-3">
      <%= t('forms.alreadyHaveAccount') %> <a href="/login" class="text-primary fw-bold text-decoration-none"><%= t('forms.login') %></a>
    </div>
  </div>
</div>
